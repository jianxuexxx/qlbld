/* ===== MissionDetail 任务详情（统一规范） ===== */

.mission-info_title {
  margin-bottom: 16rpx;
  font-size: var(--font-md);
  color: var(--color-text-primary);
  font-weight: 600;
}

.mission-info_desc {
  font-size: var(--font-base);
  color: var(--color-text-body);
  line-height: 1.6;
  word-break: break-all;
}

.mission-info_credit {
  font-size: var(--font-base);
  color: var(--color-primary);
  margin-left: 16rpx;
  font-weight: 600;
}

/* === 订单视图样式 === */
.status-completed {
  display: inline-flex;
  align-items: center;
  height: 36rpx;
  padding: 0 20rpx;
  background: var(--color-success-light);
  color: var(--color-success-dark);
  border-radius: 18rpx;
  font-size: var(--font-xs);
  font-weight: 600;
  line-height: 1;
}

.status-pending {
  display: inline-flex;
  align-items: center;
  height: 36rpx;
  padding: 0 20rpx;
  background: var(--color-primary-lighter);
  color: var(--color-primary);
  border-radius: 18rpx;
  font-size: var(--font-xs);
  font-weight: 600;
  line-height: 1;
}

.dish-list {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: var(--color-bg-sub);
  border-radius: var(--radius-md);
}

.dish-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}
.dish-item:last-child {
  border-bottom: none;
}

.dish-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.dish-title {
  font-size: var(--font-md);
  color: var(--color-text-primary);
  font-weight: 600;
  flex: 1;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-credit {
  font-size: var(--font-base);
  color: var(--color-primary);
  font-weight: 700;
  flex-shrink: 0;
}

.dish-meta {
  margin-top: 8rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  align-items: center;
}

.dish-category {
  display: inline-flex;
  align-items: center;
  height: 28rpx;
  padding: 0 10rpx;
  border-radius: var(--radius-sm);
  font-size: 22rpx;
  background: var(--color-bg-input);
  color: var(--color-text-secondary);
  line-height: 1;
}

.dish-desc {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
  line-height: 1.4;
}

.finish-btn {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  color: white;
  border-radius: var(--radius-pill);
  font-size: var(--font-md);
  margin-top: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-weight: 600;
  border: none;
  box-shadow: var(--shadow-primary);
}
.finish-btn::after { border: none; }
.finish-btn:active { transform: scale(0.98); opacity: 0.92; }

/* 进度条容器 */
.detail-progress-wrap {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.detail-progress-text {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}
