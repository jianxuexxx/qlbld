/* ============================================
   「薛师傅便利店」菜单模块样式
   基准：iPhone 14 (375pt) / 750rpx 设计稿
   主题：史迪奇蓝色调（#2196F3 / #1565C0）
   ============================================ */

/* ===== 页面容器 ===== */
.container {
  padding: 0 0 180rpx;  /* 底部留出购物车条空间 */
  background-color: #F2F5FB;
  min-height: 100vh;
  box-sizing: border-box;
}

.container.white {
  background-color: #F2F5FB;
}

/* ===== 空状态 ===== */
.background {
  width: 360rpx;
  height: 360rpx;
  display: block;
  margin: 120rpx auto 0;
}
.title {
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
  margin-top: 32rpx;
  color: #0D2A4D;
}
.subtitle {
  font-size: 26rpx;
  text-align: center;
  color: #8E8E93;
  margin-top: 12rpx;
}

/* ===== 顶部轮播图 ===== */
.menu-swiper {
  margin: 0 0 24rpx;
  height: 280rpx;
}
.menu-swiper .swiper-image {
  width: 100%;
  height: 280rpx;
  border-radius: 0 0 28rpx 28rpx;
}
.menu-swiper-wrap {
  position: relative;
}

/* ===== 搜索栏 ===== */
.search-block {
  margin: 0 0 40rpx;  /* 与下方主体明显拉开间距 */
  display: flex;
  justify-content: center;  /* 搜索条水平居中 */
}
.search-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  width: 80%;  /* 整体搜索条收紧到 80% 宽度，留两侧呼吸 */
}
.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 32rpx;
  padding: 0 20rpx;
  height: 60rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 14rpx rgba(13, 42, 77, 0.06);
}
.search-icon {
  margin-right: 8rpx;
  color: #8E8E93;
}
.search-input {
  flex: 1;
  font-size: 24rpx;
  color: #0D2A4D;
  height: 60rpx;
}
.placeholder {
  color: #B0BAC9;
}

/* 菜品管理入口（搜索栏右侧独立按钮） */
.manage-entry {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #2196F3 0%, #1565C0 100%);
  border-radius: 50%;
  font-size: 24rpx;
  color: #FFFFFF;
  flex-shrink: 0;
  box-shadow: 0 4rpx 10rpx rgba(33, 150, 243, 0.32);
}
.manage-entry-hover {
  background: linear-gradient(135deg, #1E88E5 0%, #0D47A1 100%);
  transform: scale(0.94);
}

/* ===== 左右分栏布局 ===== */
.menu-layout {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  padding: 0 24rpx;
  /* 关键：固定高度，让左右两个 scroll-view 共享同一高度，
     避免右侧内容为空时左右比例失衡 */
  height: calc(100vh - 280rpx - 116rpx - 200rpx); /* 100vh - swiper - search - cart-bar */
  min-height: 600rpx;
  max-height: 900rpx;
  box-sizing: border-box;
}

/* 左侧分类栏 */
.category-scroll {
  width: 168rpx;
  flex-shrink: 0;
  padding: 12rpx 0;
  box-sizing: border-box;
  height: 100%;
  min-height: 0;  /* 关键：flex item 默认 min-height: auto 会撑开 */
}
.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 22rpx 14rpx;
  font-size: 26rpx;
  line-height: 1.3;
  color: #5A6B85;
  position: relative;
  transition: color 0.2s ease, background-color 0.2s ease;
  box-sizing: border-box;
  min-height: 104rpx;
  margin: 6rpx 12rpx;
  border-radius: 16rpx;
  background-color: transparent;
}
.category-item-name {
  line-height: 1.3;
  text-align: center;
  word-break: break-all;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 26rpx;
  font-weight: 500;
}
.category-item-count {
  display: inline-block;
  min-width: 32rpx;
  height: 28rpx;
  padding: 0 8rpx;
  margin-top: 8rpx;
  border-radius: 14rpx;
  background-color: #FFE4E1;
  color: #E53935;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 28rpx;
  text-align: center;
}
.category-item.active {
  background-color: #FFFFFF;
  color: #1565C0;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(13, 42, 77, 0.08);
}
.category-item.active::before {
  content: '';
  position: absolute;
  left: 6rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #2196F3, #1565C0);
  border-radius: 4rpx;
}
.category-item.active .category-item-count {
  background: linear-gradient(135deg, #2196F3 0%, #1565C0 100%);
  color: #FFFFFF;
}
.category-item-hover {
  background-color: rgba(33, 150, 243, 0.06);
}

/* 右侧菜品滚动区 */
.menu-scroll {
  flex: 1;
  min-width: 0;
  min-height: 0;  /* 关键：flex item 默认 min-height: auto 会撑开 */
  height: 100%;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 18rpx rgba(13, 42, 77, 0.06);
}

/* 搜索结果提示 */
.search-tip {
  display: flex;
  align-items: center;
  background-color: #E3F2FD;
  border-left: 6rpx solid #2196F3;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  margin: 16rpx 4rpx;
  font-size: 24rpx;
  color: #1565C0;
  font-weight: 500;
}

/* 搜索清除按钮 */
.search-clear {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #C8C9CC;
  color: #FFFFFF;
  border-radius: 50%;
  font-size: 22rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
}
.search-clear:active {
  background-color: #8E8E93;
}

/* ===== 顶部留白（防止首菜顶到搜索栏） ===== */
.menu-scroll-spacer {
  height: 8rpx;
  flex-shrink: 0;
}

/* ===== 底部留白（防止最后一张菜被购物车条遮挡） ===== */
.menu-scroll-bottom-spacer {
  height: 160rpx;
  flex-shrink: 0;
}

/* ===== 分类 section 标题 ===== */
.menu-section {
  margin-bottom: 12rpx;
}
.section-title {
  display: flex;
  align-items: center;
  margin: 22rpx 8rpx 18rpx;
  padding: 10rpx 0;
  position: relative;
}
.section-title-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #0D2A4D;
  letter-spacing: 1rpx;
  padding-left: 18rpx;
  position: relative;
}
.section-title-name::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #2196F3, #1565C0);
  border-radius: 4rpx;
}
.section-title-count {
  font-size: 22rpx;
  color: #8E8E93;
  margin-left: 12rpx;
  background-color: #F2F5FB;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}

/* ===== 菜品卡片 ===== */
.menu-card-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding-bottom: 16rpx;
}
.menu-card {
  position: relative;
  background-color: #FFFFFF;
  border-radius: 18rpx;
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 2rpx 10rpx rgba(13, 42, 77, 0.04);
  transition: box-shadow 0.2s ease, transform 0.1s ease;
  border: 2rpx solid #F2F5FB;
  overflow: hidden;
}
.menu-card:active {
  transform: scale(0.99);
  box-shadow: 0 6rpx 18rpx rgba(13, 42, 77, 0.1);
  border-color: #BBDEFB;
}

/* 顶部行：图标 + 信息 */
.menu-card-row {
  display: flex;
  align-items: center;
  width: 100%;
}
.menu-card-row--top {
  min-height: 88rpx;
}
/* 底部行：积分区上方的留白 + stepper 独占一行，绝不和 meta 同行 */
.menu-card-row--bottom {
  justify-content: flex-end;
  margin-top: 12rpx;
  min-height: 44rpx;
}
.menu-card-row-spacer {
  flex: 1;
}

/* 菜品左侧：图标区（emoji 占位 + 厨师标识） */
.menu-card-left {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
  overflow: hidden;
}
.menu-card-left-image {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}
.menu-card-author {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 2rpx solid #FFFFFF;
  background-color: #FFFFFF;
  overflow: hidden;
  box-shadow: 0 2rpx 4rpx rgba(13, 42, 77, 0.15);
}
.menu-card-author image {
  width: 100%;
  height: 100%;
}

/* 菜品中部：信息 */
.menu-card-center {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 4rpx;
}
.menu-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0D2A4D;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.menu-card-desc {
  font-size: 22rpx;
  color: #8E8E93;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.menu-card-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 4rpx;
  flex-wrap: wrap;
}
.menu-card-tag {
  display: inline-flex;
  align-items: center;
  height: 28rpx;
  padding: 0 10rpx;
  border-radius: 6rpx;
  background-color: #F2F5FB;
  color: #5A6B85;
  font-size: 20rpx;
}
.menu-card-credit {
  display: inline-flex;
  align-items: center;
  height: 30rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, rgba(33,150,243,0.12) 0%, rgba(21,101,192,0.16) 100%);
  color: #1565C0;
  font-size: 20rpx;
  font-weight: 700;
}
.menu-card-star {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 28rpx;
  height: 28rpx;
  z-index: 2;
}

/* 右下：数量加减器（流式独占一行底部） */
.stepper {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  height: 44rpx;
  z-index: 1;
}
.stepper-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2196F3 0%, #1565C0 100%);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 300;
  line-height: 1;
  box-shadow: 0 4rpx 10rpx rgba(33, 150, 243, 0.35);
  transition: transform 0.1s ease;
  flex-shrink: 0;
}
.stepper-btn-hover {
  transform: scale(0.9);
  opacity: 0.85;
}
.stepper-minus {
  margin-right: 8rpx;
  background: #FFFFFF;
  color: #2196F3;
  border: 2rpx solid #2196F3;
  box-shadow: 0 2rpx 4rpx rgba(33, 150, 243, 0.15);
}
.stepper-count {
  min-width: 36rpx;
  max-width: 56rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #0D2A4D;
  margin: 0 6rpx;
  line-height: 44rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  animation: stepper-pop 0.18s ease-out;
}
@keyframes stepper-pop {
  0% { transform: scale(0.6); opacity: 0; }
  60% { transform: scale(1.15); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}
.stepper-active .stepper-plus {
  background: linear-gradient(135deg, #4CAF50 0%, #2E7D32 100%);
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.3);
}
/* 紧凑型（小尺寸，购物车面板使用） */
.stepper-mini {
  position: static;
  height: 48rpx;
}
.stepper-mini .stepper-btn {
  width: 48rpx;
  height: 48rpx;
  font-size: 30rpx;
  box-shadow: 0 2rpx 6rpx rgba(33, 150, 243, 0.25);
}
.stepper-mini .stepper-minus {
  margin-right: 12rpx;
  box-shadow: none;
}
.stepper-mini .stepper-count {
  min-width: 48rpx;
  font-size: 28rpx;
  margin: 0 12rpx 0 0;
  line-height: 48rpx;
}

/* 空分类状态 */
.empty-category {
  text-align: center;
  padding: 80rpx 0;
  color: #8E8E93;
  font-size: 26rpx;
}

/* 通用空状态（搜索无结果 / 分类为空） */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx;
  color: #8E8E93;
  text-align: center;
  min-height: 280rpx;
}
.empty-state-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}
.empty-state-text {
  font-size: 28rpx;
  color: #5A6B85;
  font-weight: 500;
  margin-bottom: 12rpx;
  line-height: 1.4;
}
.empty-state-hint {
  font-size: 24rpx;
  color: #B0BAC9;
  line-height: 1.4;
}

/* ===== 购物车底部条 ===== */
.cart-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #FFFFFF;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(13, 42, 77, 0.08);
  display: flex;
  align-items: center;
  z-index: 998;
}

/* 浮动购物车图标（向上突出） */
.cart-bar-icon-wrap {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  margin-top: -44rpx;          /* 向上突出 */
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.cart-bar-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background-color: #E5E5E5;
  color: #999999;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  box-shadow: 0 4rpx 12rpx rgba(13, 42, 77, 0.08);
  transition: background-color 0.2s ease;
}
.cart-bar-icon-active {
  background: linear-gradient(135deg, #2196F3 0%, #1565C0 100%);
  color: #FFFFFF;
  box-shadow: 0 6rpx 18rpx rgba(33, 150, 243, 0.45);
  animation: cart-pulse 2s ease-in-out infinite;
}
@keyframes cart-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.cart-bar-badge {
  position: absolute;
  top: 0;
  right: 0;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 18rpx;
  background-color: #FF3B30;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 36rpx;
  text-align: center;
  border: 3rpx solid #FFFFFF;
  box-sizing: border-box;
}

.cart-bar-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-left: 4rpx;
  line-height: 1.3;
  min-width: 0;
}
.cart-bar-text {
  font-size: 24rpx;
  color: #8E8E93;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cart-bar-text-empty {
  font-size: 28rpx;
  color: #8B98AE;
}
.cart-bar-count {
  color: #1565C0;
  font-weight: 700;
  font-size: 28rpx;
  margin: 0 4rpx;
}
.cart-bar-credit {
  color: #1565C0;
  font-weight: 700;
  font-size: 28rpx;
  margin: 0 4rpx;
}
.cart-bar-hint {
  font-size: 22rpx;
  color: #B0BAC9;
  margin-top: 4rpx;
}

.cart-bar-btn {
  background: linear-gradient(135deg, #2196F3 0%, #1565C0 100%);
  color: #FFFFFF;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 40rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
  box-shadow: 0 6rpx 16rpx rgba(33, 150, 243, 0.4);
  flex-shrink: 0;
}
.cart-bar-btn[disabled],
.cart-bar-btn.cart-bar-btn-disabled {
  background: #E5E5E5;
  color: #999999;
  box-shadow: none;
}

/* ===== 购物车展开面板 ===== */
.cart-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(13, 42, 77, 0.45);
  z-index: 999;
  animation: mask-fade 0.3s ease;
}
@keyframes mask-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

.cart-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 70vh;
  min-height: 400rpx;
  background-color: #FFFFFF;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  z-index: 1000;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  flex-direction: column;
  box-shadow: 0 -8rpx 32rpx rgba(13, 42, 77, 0.12);
}
.cart-panel-open {
  transform: translateY(0);
}

.cart-panel-handle {
  width: 56rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background-color: #D8DEE8;
  margin: 16rpx auto 0;
}
.cart-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx 16rpx;
}
.cart-panel-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0D2A4D;
}
.cart-panel-clear {
  font-size: 24rpx;
  color: #8E8E93;
  padding: 8rpx 12rpx;
}
.cart-panel-clear:active {
  color: #FF3B30;
}

.cart-panel-body {
  flex: 1;
  padding: 0 24rpx 24rpx;
  overflow-y: auto;
}

.cart-empty {
  text-align: center;
  padding: 80rpx 0;
  color: #B0BAC9;
  font-size: 26rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.cart-empty-icon {
  font-size: 80rpx;
  opacity: 0.5;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  border-bottom: 1rpx solid #F2F5FB;
}
.cart-item:last-child {
  border-bottom: none;
}
.cart-item-emoji {
  width: 104rpx;
  height: 104rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.cart-item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.cart-item-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #0D2A4D;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cart-item-credit {
  font-size: 24rpx;
  color: #1565C0;
  font-weight: 600;
}
.cart-item-remove {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #2196F3;
  background-color: transparent;
  color: #2196F3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 300;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.cart-item-remove:active {
  background-color: #BBDEFB;
}

.cart-panel-footer {
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #F2F5FB;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #FAFBFD;
}
.cart-panel-total {
  display: flex;
  flex-direction: column;
}
.cart-panel-total-label {
  font-size: 24rpx;
  color: #8E8E93;
}
.cart-panel-total-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1565C0;
  margin-top: 4rpx;
}
.cart-panel-confirm-btn {
  background: linear-gradient(135deg, #2196F3 0%, #1565C0 100%);
  color: #FFFFFF;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 40rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
  box-shadow: 0 6rpx 16rpx rgba(33, 150, 243, 0.4);
}
.cart-panel-confirm-btn[disabled] {
  background: #E5E5E5;
  color: #999999;
  box-shadow: none;
}