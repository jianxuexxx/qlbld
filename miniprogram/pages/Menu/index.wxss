.container {
  padding: 20px;
  padding-bottom: 140rpx; /* 给底部购物车条留位 */
}

.background {
  width: 100%;
  height: 200px;
}

.title {
  font-size: 24px;
  text-align: center;
  margin-top: 20px;
}

.subtitle {
  font-size: 16px;
  text-align: center;
  color: gray;
  margin-top: 10px;
}

.swiper-image {
  width: 100%;
  height: 200px;
}

.form-group {
  margin-bottom: 20px;
}

.form-group_label {
  font-weight: bold;
  font-size: 18px;
  margin-bottom: 10px;
  display: flex;
  align-items: center;
}

.search-bar {
  display: flex;
  align-items: center;
  background-color: white;
  border-radius: 20px;
  padding: 5px 15px;
  margin-bottom: 10px;
}

.search-icon {
  margin-right: 10px;
}

.search-input {
  flex: 1;
  font-size: 16px;
}

.slide {
  display: flex;
  align-items: center;
  padding: 5px;
  background-color: white;
  position: relative;
  padding-right: 80rpx; /* 给加号按钮留位置 */
}

.menu-info {
  flex: 1;
  min-width: 0;
}

.menu-info_title {
  font-weight: bold;
  font-size: 16px;
}

.menu-info_award {
  font-size: 14px;
  color: #ff6b6b;
}

.menu-info_category {
  font-size: 12px;
  color: #666;
}

.menu-info_date {
  font-size: 12px;
  color: #999;
}

.menu-info_author {
  width: 50px;
  height: 50px;
  margin-left: 10px;
  position: relative;
}

.star {
  position: absolute;
  top: 10px;
  right: 10px;
  width: 20px;
  height: 20px;
}

.btn-normal {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  background-color: #ff99aa;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  position: absolute;
  right: 20px;
  bottom: 20px;
}

.btn-hover {
  background-color: #ff7c90;
}

.menu-layout {
  display: flex;
  gap: 2px;
}

.category-scroll {
  width: 30%;
  background-color: #f5f5f5;
  border-radius: 8px;
  padding: 5px 0;
}

.menu-scroll {
  width: 100%;
  transition: height 0.3s ease;
}
.menu-scroll-with-cart {
  /* 展开购物车面板时缩短滚动区（可由 JS 动态调整 scrollHeight） */
}

.category-item {
  padding: 12px 15px;
  text-align: center;
  font-size: 14px;
  cursor: pointer;
}

.category-item.active {
  background-color: #fff;
  color: #ff99aa;
  font-weight: bold;
  border-left: 3px solid #ff99aa;
}

.empty-category {
  text-align: center;
  padding: 20px;
  color: #999;
}

.white {
  background-color: white;
}

/* === 菜品管理弱化入口 === */
.manage-entry {
  font-size: 12px;
  color: #ff99aa;
  padding: 4px 10px;
  border: 1px solid #ff99aa;
  border-radius: 14px;
  background-color: #fff5f7;
  white-space: nowrap;
  margin-left: 8px;
}
.manage-entry-hover {
  background-color: #ffe6ec;
}

/* === 购物车加号按钮 === */
.add-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: #ff99aa;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 300;
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  box-shadow: 0 4rpx 8rpx rgba(255, 153, 170, 0.4);
  transition: background-color 0.2s ease, transform 0.1s ease;
  z-index: 5;
}
.add-btn:active {
  transform: translateY(-50%) scale(0.9);
}
.add-btn-checked {
  background-color: #07c160;
  box-shadow: 0 4rpx 8rpx rgba(7, 193, 96, 0.3);
  font-size: 36rpx;
}

/* === 购物车底部条 === */
.cart-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #ffffff;
  padding: 16rpx 24rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  z-index: 998;
}

.cart-bar-icon {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.cart-bar-badge {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background-color: #ff4d4f;
  color: white;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
}

.cart-bar-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 8rpx;
  line-height: 1.4;
}

.cart-bar-text {
  font-size: 24rpx;
  color: #999;
}

.cart-bar-count,
.cart-bar-credit {
  color: #ff99aa;
  font-weight: bold;
  font-size: 28rpx;
}

.cart-bar-total {
  font-size: 24rpx;
  color: #666;
  margin-left: 12rpx;
}

.cart-bar-btn {
  background-color: #ff99aa;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
}
.cart-bar-btn[disabled],
.cart-bar-btn-disabled {
  background-color: #ffc4d0;
  color: #fff;
}

/* === 购物车展开面板 === */
.cart-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 999;
}

.cart-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 60vh;
  background-color: #fafafa;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  z-index: 1000;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  display: flex;
  flex-direction: column;
}
.cart-panel-open {
  transform: translateY(0);
}

.cart-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #eee;
  background-color: #fff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
}

.cart-panel-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.cart-panel-clear {
  font-size: 24rpx;
  color: #ff99aa;
  padding: 8rpx 16rpx;
}

.cart-panel-body {
  flex: 1;
  padding: 16rpx 24rpx;
}

.cart-empty {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 26rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #fff;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.cart-item-info {
  flex: 1;
}

.cart-item-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.cart-item-credit {
  font-size: 24rpx;
  color: #ff99aa;
  margin-top: 4rpx;
}

.cart-item-remove {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: #fff0f3;
  color: #ff99aa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}
.cart-item-remove:active {
  background-color: #ffe0e6;
}