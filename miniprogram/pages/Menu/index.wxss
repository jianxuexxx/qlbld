/* ============================================
   「薛师傅便利店」菜单模块样式
   基准：iPhone 14 (375pt) / 750rpx 设计稿
   主色：#FF99AA  辅助：#07C160
   ============================================ */

/* === 设计变量（部分属性通过 WXSS 注释说明，实际值直接写入） === */

/* ===== 页面容器 ===== */
.container {
  padding: 0 24rpx 140rpx;  /* 底部留出购物车条空间 */
  background-color: #F7F8FA;
  min-height: 100vh;
  box-sizing: border-box;
}

.container.white {
  background-color: #F7F8FA;
}

/* ===== 空状态 ===== */
.background {
  width: 360rpx;
  height: 360rpx;
  display: block;
  margin: 120rpx auto 0;
}
.title {
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
  margin-top: 32rpx;
  color: #1A1A1A;
}
.subtitle {
  font-size: 26rpx;
  text-align: center;
  color: #8E8E93;
  margin-top: 12rpx;
}

/* ===== 顶部轮播图 ===== */
.menu-swiper {
  margin: 0 -24rpx 24rpx;       /* 突破左右 padding，扩到全屏宽 */
  height: 320rpx;
}
.menu-swiper .swiper-image {
  width: 100%;
  height: 320rpx;
  border-radius: 0 0 24rpx 24rpx;
}
.menu-swiper-wrap {
  position: relative;
}

/* ===== 搜索栏 ===== */
.search-row {
  display: flex;
  align-items: center;
  margin: 0 0 20rpx;
  gap: 16rpx;
}
.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #F5F6F8;
  border-radius: 36rpx;
  padding: 0 24rpx;
  height: 72rpx;
  box-sizing: border-box;
}
.search-icon {
  margin-right: 12rpx;
  color: #8E8E93;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
  height: 72rpx;
}
.placeholder {
  color: #C8C9CC;
}

/* 菜品管理入口（搜索栏右侧独立按钮） */
.manage-entry {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #FFF0F3;
  border-radius: 50%;
  font-size: 36rpx;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(255, 153, 170, 0.15);
}
.manage-entry-hover {
  background-color: #FFE6EC;
  transform: scale(0.95);
}

/* ===== 分类胶囊（旧版样式已废弃，wxml 不再使用，删除以避免命名污染） ===== */

/* ===== 左右分栏布局 ===== */
.menu-layout {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  /* 关键：固定高度，让左右两个 scroll-view 共享同一高度，
     避免右侧内容为空时左右比例失衡 */
  height: calc(100vh - 320rpx - 88rpx - 140rpx); /* 100vh - swiper - search - cart-bar */
  min-height: 600rpx;
  max-height: 900rpx;
  box-sizing: border-box;
}

/* 左侧分类栏 */
.category-scroll {
  width: 180rpx;
  flex-shrink: 0;
  background-color: #FAFAFA;
  border-radius: 16rpx;
  padding: 12rpx 0;
  box-sizing: border-box;
  height: 100%;
  min-height: 0;  /* 关键：flex item 默认 min-height: auto 会撑开 */
}
.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 12rpx 20rpx 18rpx;  /* 左侧 18rpx 为指示条留位 */
  font-size: 28rpx;
  line-height: 1.3;
  color: #666666;
  position: relative;
  transition: color 0.2s ease, background-color 0.2s ease, font-weight 0.2s ease, box-shadow 0.2s ease;
  box-sizing: border-box;
  min-height: 96rpx;
}
.category-item-name {
  line-height: 1.3;
  text-align: center;
  word-break: break-all;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 28rpx;
}
.category-item-count {
  display: inline-block;
  min-width: 32rpx;
  height: 28rpx;
  padding: 0 8rpx;
  margin-top: 8rpx;
  border-radius: 14rpx;
  background-color: #FF3B30;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 28rpx;
  text-align: center;
}
.category-item.active {
  background-color: #FFFFFF;
  color: #FF99AA;
  font-weight: 600;
  /* 用 box-shadow 实现指示条（不受 overflow/scroll 影响） */
  box-shadow: inset 6rpx 0 0 #FF99AA;
}
.category-item.active .category-item-count {
  background-color: #FF99AA;
  color: #FFFFFF;
}
.category-item-hover {
  background-color: #F0F0F0;
}

/* 右侧菜品滚动区 */
.menu-scroll {
  flex: 1;
  min-width: 0;
  min-height: 0;  /* 关键：flex item 默认 min-height: auto 会撑开 */
  height: 100%;
  padding: 0 8rpx;
  box-sizing: border-box;
}

/* 搜索结果提示 */
.search-tip {
  display: flex;
  align-items: center;
  background-color: #FFF5F7;
  border-left: 6rpx solid #FF99AA;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  margin: 0 4rpx 16rpx;
  font-size: 24rpx;
  color: #FF7A8E;
  font-weight: 500;
}

/* 搜索清除按钮 */
.search-clear {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #C8C9CC;
  color: #FFFFFF;
  border-radius: 50%;
  font-size: 22rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
}
.search-clear:active {
  background-color: #8E8E93;
}

/* ===== 当前分类标题 ===== */
.section-title {
  display: flex;
  align-items: baseline;
  margin: 8rpx 0 20rpx;
  padding: 0 4rpx;
}
.section-title-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}
.section-title-count {
  font-size: 22rpx;
  color: #8E8E93;
  margin-left: 12rpx;
}

/* ===== 菜品卡片 ===== */
.menu-card-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 24rpx;
}
.menu-card {
  position: relative;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: box-shadow 0.2s ease, transform 0.1s ease;
  margin: 0 4rpx;  /* 微错落感 */
}
.menu-card:active {
  transform: scale(0.99);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

/* 菜品左侧：图标区（emoji 占位 + 厨师标识） */
.menu-card-left {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #FFE6EC 0%, #FFF5F7 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  overflow: hidden;
}
.menu-card-left-image {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}
.menu-card-author {
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #FFFFFF;
  background-color: #FFFFFF;
  overflow: hidden;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
}
.menu-card-author image {
  width: 100%;
  height: 100%;
}

/* 菜品中部：信息 */
.menu-card-center {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
  padding-right: 88rpx;  /* 给加号按钮留位 */
}
.menu-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.menu-card-desc {
  font-size: 24rpx;
  color: #8E8E93;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.menu-card-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 4rpx;
  flex-wrap: wrap;
}
.menu-card-tag {
  display: inline-flex;
  align-items: center;
  height: 32rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  background-color: #F5F6F8;
  color: #666666;
  font-size: 22rpx;
}
.menu-card-credit {
  display: inline-flex;
  align-items: center;
  height: 36rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  background-color: #FFF0F3;
  color: #FF99AA;
  font-size: 24rpx;
  font-weight: 600;
}
.menu-card-star {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 28rpx;
  height: 28rpx;
  z-index: 2;
}

/* 菜品右侧：加号按钮（绝对定位右上） */
.add-btn {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: #FF99AA;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 300;
  box-shadow: 0 4rpx 12rpx rgba(255, 153, 170, 0.35);
  transition: background-color 0.2s ease, transform 0.1s ease;
  z-index: 5;
}
.add-btn:active {
  transform: scale(0.9);
}
.add-btn-checked {
  background-color: #07C160;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
  font-size: 32rpx;
  font-weight: 600;
}

/* 空分类状态 */
.empty-category {
  text-align: center;
  padding: 80rpx 0;
  color: #8E8E93;
  font-size: 26rpx;
}

/* 通用空状态（搜索无结果 / 分类为空） */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx;
  color: #8E8E93;
  text-align: center;
  min-height: 280rpx;
}
.empty-state-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}
.empty-state-text {
  font-size: 28rpx;
  color: #666666;
  font-weight: 500;
  margin-bottom: 12rpx;
  line-height: 1.4;
}
.empty-state-hint {
  font-size: 24rpx;
  color: #C8C9CC;
  line-height: 1.4;
}

/* ===== 购物车底部条 ===== */
.cart-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #FFFFFF;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  z-index: 998;
}

/* 浮动购物车图标（向上突出） */
.cart-bar-icon-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  margin-top: -40rpx;          /* 向上突出 */
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.cart-bar-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #E5E5E5;
  color: #999999;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: background-color 0.2s ease;
}
.cart-bar-icon-active {
  background-color: #FF99AA;
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(255, 153, 170, 0.4);
  animation: cart-pulse 2s ease-in-out infinite;
}
@keyframes cart-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.cart-bar-badge {
  position: absolute;
  top: 0;
  right: 0;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 18rpx;
  background-color: #FF3B30;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 36rpx;
  text-align: center;
  border: 2rpx solid #FFFFFF;
  box-sizing: border-box;
}

.cart-bar-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-left: 4rpx;
  line-height: 1.3;
  min-width: 0;
}
.cart-bar-text {
  font-size: 24rpx;
  color: #8E8E93;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cart-bar-text-empty {
  font-size: 28rpx;
  color: #C8C9CC;
}
.cart-bar-count {
  color: #FF99AA;
  font-weight: 700;
  font-size: 28rpx;
  margin: 0 4rpx;
}
.cart-bar-credit {
  color: #FF99AA;
  font-weight: 700;
  font-size: 28rpx;
  margin: 0 4rpx;
}
.cart-bar-hint {
  font-size: 22rpx;
  color: #C8C9CC;
  margin-top: 4rpx;
}

.cart-bar-btn {
  background: linear-gradient(135deg, #FF99AA 0%, #FF7A8E 100%);
  color: #FFFFFF;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 40rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
  box-shadow: 0 4rpx 12rpx rgba(255, 153, 170, 0.4);
  flex-shrink: 0;
}
.cart-bar-btn[disabled],
.cart-bar-btn.cart-bar-btn-disabled {
  background: #E5E5E5;
  color: #999999;
  box-shadow: none;
}

/* ===== 购物车展开面板 ===== */
.cart-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 999;
  animation: mask-fade 0.3s ease;
}
@keyframes mask-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

.cart-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 70vh;
  min-height: 400rpx;
  background-color: #FFFFFF;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  z-index: 1000;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  flex-direction: column;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.12);
}
.cart-panel-open {
  transform: translateY(0);
}

.cart-panel-handle {
  width: 48rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background-color: #E5E5E5;
  margin: 16rpx auto 0;
}
.cart-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx 16rpx;
}
.cart-panel-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}
.cart-panel-clear {
  font-size: 24rpx;
  color: #8E8E93;
  padding: 8rpx 12rpx;
}
.cart-panel-clear:active {
  color: #FF3B30;
}

.cart-panel-body {
  flex: 1;
  padding: 0 24rpx 24rpx;
  overflow-y: auto;
}

.cart-empty {
  text-align: center;
  padding: 80rpx 0;
  color: #C8C9CC;
  font-size: 26rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.cart-empty-icon {
  font-size: 80rpx;
  opacity: 0.5;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.cart-item:last-child {
  border-bottom: none;
}
.cart-item-emoji {
  width: 104rpx;
  height: 104rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #FFE6EC 0%, #FFF5F7 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.cart-item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.cart-item-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1A1A1A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cart-item-credit {
  font-size: 24rpx;
  color: #FF99AA;
  font-weight: 600;
}
.cart-item-remove {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #FF99AA;
  background-color: transparent;
  color: #FF99AA;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 300;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.cart-item-remove:active {
  background-color: #FFE6EC;
}

.cart-panel-footer {
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #F0F0F0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #FAFAFA;
}
.cart-panel-total {
  display: flex;
  flex-direction: column;
}
.cart-panel-total-label {
  font-size: 24rpx;
  color: #8E8E93;
}
.cart-panel-total-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF99AA;
  margin-top: 4rpx;
}
.cart-panel-confirm-btn {
  background: linear-gradient(135deg, #FF99AA 0%, #FF7A8E 100%);
  color: #FFFFFF;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 40rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
  box-shadow: 0 4rpx 12rpx rgba(255, 153, 170, 0.4);
}
.cart-panel-confirm-btn[disabled] {
  background: #E5E5E5;
  color: #999999;
  box-shadow: none;
}