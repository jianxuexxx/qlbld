<wxs module="util" src="../util.wxs" />

<!-- 顶部轮播图 -->
<swiper wx:if="{{allMenus.length > 0}}"
  class="menu-swiper"
  indicator-dots="true"
  indicator-color="rgba(255,255,255,0.4)"
  indicator-active-color="#FFFFFF"
  autoplay="true"
  interval="3000"
  duration="500"
  circular="true">
  <swiper-item><image src="Images/MenuCover04.jpg" mode="aspectFill" class="swiper-image" /></swiper-item>
  <swiper-item><image src="Images/MenuCover05.jpg" mode="aspectFill" class="swiper-image" /></swiper-item>
</swiper>

<view class="container {{allMenus.length === 0 ? 'white' : ''}}">

  <!-- 空状态 -->
  <view wx:if="{{allMenus.length === 0}}">
    <image class="background" src="Images/None.png" mode="aspectFit" />
    <view class="title">暂无菜品</view>
    <view class="subtitle">快去添加一道拿手好菜吧～</view>
  </view>

  <block wx:if="{{allMenus.length > 0}}">

    <!-- 搜索栏 + 菜品管理入口 -->
    <view class="search-block">
      <view class="search-row">
        <view class="search-bar">
          <icon class="search-icon" type="search" size="16" color="#8E8E93"></icon>
          <input class="search-input" placeholder-class="placeholder" placeholder="搜索想吃的菜…" bindinput="onSearch" value="{{search}}" />
          <view wx:if="{{search}}" class="search-clear" bindtap="clearSearch">✕</view>
        </view>
        <view class="manage-entry" hover-class="manage-entry-hover" bindtap="toAddPage">🍳</view>
      </view>
    </view>

    <!-- 左右分栏布局 -->
    <view class="menu-layout">
      <!-- 左侧分类栏 -->
      <scroll-view class="category-scroll"
        scroll-y="true"
        scroll-with-animation="true"
        scroll-into-view="{{scrollIntoViewCategoryId}}"
        enhanced="true"
        show-scrollbar="{{false}}">
        <view wx:for="{{categories}}"
              wx:key="index"
              id="category-item-{{index}}"
              class="category-item {{currentCategoryIndex === index ? 'active' : ''}}"
              bindtap="switchCategory"
              data-index="{{index}}"
              hover-class="category-item-hover">
          <text class="category-item-name">{{item.name}}</text>
          <text wx:if="{{item.count > 0}}" class="category-item-count">{{item.count}}</text>
        </view>
      </scroll-view>

      <!-- 右侧菜品栏：连续滚动，按分类切 section -->
      <scroll-view class="menu-scroll"
        scroll-y="true"
        scroll-with-animation="true"
        scroll-into-view="{{scrollIntoViewMenuId}}"
        bindscroll="onMenuScroll"
        scroll-top="{{menuScrollTop}}"
        enhanced="true"
        show-scrollbar="{{false}}">

        <!-- 顶部间距（不顶到搜索栏） -->
        <view class="menu-scroll-spacer" id="menu-top-anchor"></view>

        <!-- 全局搜索提示（搜索时统一提示） -->
        <view class="search-tip" wx:if="{{search}}">
          🔍 搜索 "{{search}}" 的结果（{{totalMatchCount}} 道）
        </view>

        <!-- 全局空状态 -->
        <view class="empty-state" wx:if="{{displayedMenus.length === 0 && search}}">
          <text class="empty-state-icon">🔍</text>
          <text class="empty-state-text">没有找到 "{{search}}" 相关菜品</text>
          <text class="empty-state-hint">试试切换其他分类或更换关键词</text>
        </view>

        <view class="empty-state" wx:if="{{displayedMenus.length === 0 && !search}}">
          <text class="empty-state-icon">🍽️</text>
          <text class="empty-state-text">还没有添加任何菜品～</text>
          <text class="empty-state-hint">点击右上角 🍳 添加一道吧</text>
        </view>

        <!-- 按分类 section 顺序渲染 -->
        <block wx:for="{{displayedMenus}}" wx:key="categoryId" wx:for-item="section">
          <view wx:if="{{section.menus.length > 0}}"
                class="menu-section"
                id="menu-section-{{section.categoryId}}"
                data-category-index="{{section.categoryIndex}}">

            <!-- section 标题 -->
            <view class="section-title">
              <text class="section-title-name">{{section.categoryName}}</text>
              <text class="section-title-count">{{section.menus.length}} 道</text>
            </view>

            <!-- 该分类下的菜品列表 -->
            <view class="menu-card-list">
              <view class="menu-card"
                    wx:for="{{section.menus}}"
                    wx:key="_id"
                    wx:for-item="menu"
                    id="menu-item-{{menu._id}}"
                    hover-class="menu-card-hover"
                    data-id="{{menu._id}}"
                    data-category-index="{{section.categoryIndex}}"
                    bindtap="toDetailPage"
                    bindlongpress="onCardLongPress">

                <!-- 顶部行：图标 + 信息 -->
                <view class="menu-card-row menu-card-row--top">
                  <!-- 左侧图标 -->
                  <view class="menu-card-left">
                    <text>🍴</text>
                    <view class="menu-card-author">
                      <image wx:if="{{menu._openid === _openidA}}" src="Images/MenuA.png" mode="aspectFill" />
                      <image wx:if="{{menu._openid === _openidB}}" src="Images/MenuB.png" mode="aspectFill" />
                    </view>
                  </view>

                  <!-- 信息 -->
                  <view class="menu-card-center">
                    <view class="menu-card-title">{{menu.title}}</view>
                    <view class="menu-card-desc" wx:if="{{menu.desc}}">{{menu.desc}}</view>
                    <view class="menu-card-meta">
                      <view class="menu-card-tag" wx:if="{{menu.category}}">🏷️ {{menu.category}}</view>
                      <view class="menu-card-credit">💰 {{menu.credit}} 积分</view>
                    </view>
                  </view>
                </view>

                <!-- 底部行：积分左、stepper 右（独占一行，绝不和 meta 同行） -->
                <view class="menu-card-row menu-card-row--bottom">
                  <view class="menu-card-row-spacer"></view>
                  <view class="stepper {{cart[menu._id] ? 'stepper-active' : ''}}">
                    <view wx:if="{{cart[menu._id]}}"
                          class="stepper-btn stepper-minus"
                          data-id="{{menu._id}}"
                          catchtap="decCart"
                          hover-class="stepper-btn-hover">−</view>
                    <text wx:if="{{cart[menu._id]}}" class="stepper-count">{{cart[menu._id]}}</text>
                    <view class="stepper-btn stepper-plus"
                          data-id="{{menu._id}}"
                          catchtap="incCart"
                          hover-class="stepper-btn-hover">＋</view>
                  </view>
                </view>

                <!-- 收藏标识 -->
                <image wx:if="{{menu.star}}" class="menu-card-star" src="Images/Star.png" />
              </view>
            </view>
          </view>
        </block>

        <!-- 底部留白（防止最后一个卡片被购物车条遮挡） -->
        <view class="menu-scroll-bottom-spacer"></view>
      </scroll-view>
    </view>

  </block>
</view>

<!-- 购物车展开面板（mask） -->
<view class="cart-mask" wx:if="{{cartExpanded}}" bindtap="closeCart"></view>

<!-- 购物车展开面板 -->
<view class="cart-panel {{cartExpanded ? 'cart-panel-open' : ''}}">
  <view class="cart-panel-handle"></view>
  <view class="cart-panel-header">
    <text class="cart-panel-title">🛒 已选菜品 ({{cartCount}})</text>
    <view class="cart-panel-clear" bindtap="clearCart" wx:if="{{cartCount > 0}}">清空</view>
  </view>
  <scroll-view class="cart-panel-body" scroll-y="true">
    <view class="cart-empty" wx:if="{{cartCount === 0}}">
      <text class="cart-empty-icon">🍽️</text>
      <text>购物车空空如也～</text>
    </view>
    <view class="cart-item" wx:for="{{cartList}}" wx:key="_id" wx:for-item="ci">
      <view class="cart-item-emoji">🍴</view>
      <view class="cart-item-info">
        <view class="cart-item-title">{{ci.title}}</view>
        <view class="cart-item-credit">💰 {{ci.credit}} × {{ci._count}} = {{ci.credit * ci._count}} 积分</view>
      </view>
      <view class="stepper stepper-mini">
        <view class="stepper-btn stepper-minus"
              data-id="{{ci._id}}"
              catchtap="decCart"
              hover-class="stepper-btn-hover">−</view>
        <text class="stepper-count">{{ci._count}}</text>
        <view class="stepper-btn stepper-plus"
              data-id="{{ci._id}}"
              catchtap="incCart"
              hover-class="stepper-btn-hover">＋</view>
      </view>
    </view>
  </scroll-view>
  <view class="cart-panel-footer" wx:if="{{cartCount > 0}}">
    <view class="cart-panel-total">
      <text class="cart-panel-total-label">合计</text>
      <text class="cart-panel-total-value">{{cartTotalCredit}} 积分</text>
    </view>
    <button class="cart-panel-confirm-btn" size="mini" bindtap="submitOrder">去下单</button>
  </view>
</view>

<!-- 购物车底部条（始终显示） -->
<view class="cart-bar">
  <view class="cart-bar-icon-wrap" bindtap="toggleCart">
    <view class="cart-bar-icon {{cartCount > 0 ? 'cart-bar-icon-active' : ''}}">🛒</view>
    <view class="cart-bar-badge" wx:if="{{cartCount > 0}}">{{cartCount}}</view>
  </view>
  <view class="cart-bar-info" bindtap="toggleCart">
    <text class="cart-bar-text {{cartCount === 0 ? 'cart-bar-text-empty' : ''}}"
          wx:if="{{cartCount > 0}}">
      已选 <text class="cart-bar-count">{{cartCount}}</text> 道菜　共 <text class="cart-bar-credit">{{cartTotalCredit}}</text> 积分
    </text>
    <text class="cart-bar-text cart-bar-text-empty" wx:else>购物车空空如也～</text>
  </view>
  <button class="cart-bar-btn"
          size="mini"
          bindtap="submitOrder"
          disabled="{{cartCount === 0}}">去下单</button>
</view>