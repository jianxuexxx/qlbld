<view class="container">
  <!-- 本次开始 / 上次结束（左右双卡） -->
  <view class="period-summary" wx:if="{{summary.hasData}}">
    <view class="period-summary-card period-summary-card-start">
      <view class="period-summary-label">本次开始</view>
      <view wx:if="{{summary.currentStart}}" class="period-summary-value">{{summary.currentStartFriendly}}</view>
      <view wx:else class="period-summary-value period-summary-empty">—</view>
      <view wx:if="{{summary.currentStart}}" class="period-summary-sub">{{summary.currentStart}} · {{summary.currentStartWeekCN}}</view>
      <view wx:else class="period-summary-sub">尚未开始</view>
    </view>
    <view class="period-summary-card period-summary-card-end">
      <view class="period-summary-label">上次结束</view>
      <view wx:if="{{summary.lastEnd}}" class="period-summary-value">{{summary.lastEndFriendly}}</view>
      <view wx:else class="period-summary-value period-summary-empty">—</view>
      <view wx:if="{{summary.lastEnd}}" class="period-summary-sub">{{summary.lastEnd}} · {{summary.lastEndWeekCN}}</view>
      <view wx:else class="period-summary-sub">尚未结束</view>
    </view>
  </view>

  <!-- 日历（含年月选择） -->
  <view class="period-calendar">
    <!-- 日历头部：左箭头 + 年月选择（picker）+ 右箭头 -->
    <view class="period-calendar-header">
      <view class="period-calendar-nav" bindtap="prevMonth">‹</view>
      <view class="period-calendar-title">
        <picker mode="selector" value="{{yearIndex}}" range="{{yearRange}}" bindchange="onYearChange">
          <view class="period-calendar-title-pick">{{calendarYear}} 年</view>
        </picker>
        <text class="period-calendar-title-sep">/</text>
        <picker mode="selector" value="{{calendarMonth - 1}}" range="{{monthRange}}" bindchange="onMonthChange">
          <view class="period-calendar-title-pick">{{calendarMonth}} 月</view>
        </picker>
      </view>
      <view class="period-calendar-nav" bindtap="nextMonth">›</view>
    </view>

    <view class="period-calendar-weekrow">
      <view class="period-calendar-weekcell" wx:for="{{weekLabels}}" wx:key="*this">{{item}}</view>
    </view>
    <view class="period-calendar-days">
      <view wx:for="{{calendarDays}}" wx:key="index"
            class="period-calendar-day {{item.empty ? 'period-calendar-day-empty' : ''}} {{item.isToday ? 'period-calendar-day-today' : ''}} {{item.inPeriod ? 'period-calendar-day-in' : ''}} {{item.isPeriodStart ? 'period-calendar-day-start' : ''}} {{item.isPeriodEnd ? 'period-calendar-day-end' : ''}} {{item.selected ? 'period-calendar-day-selected' : ''}}"
            data-date="{{item.date}}"
            bindtap="onTapCalendarDay">
        <view class="period-calendar-day-num">{{item.day}}</view>
        <view wx:if="{{item.inPeriod && !item.isPeriodStart && !item.isPeriodEnd}}" class="period-calendar-day-tag">经</view>
        <view wx:if="{{item.isPeriodStart && !item.isPeriodEnd}}" class="period-calendar-day-tag">始</view>
        <view wx:if="{{item.isPeriodEnd && !item.isPeriodStart}}" class="period-calendar-day-tag">末</view>
        <view wx:if="{{item.isPeriodStart && item.isPeriodEnd}}" class="period-calendar-day-tag">●</view>
      </view>
    </view>
    <view class="period-calendar-legend">
      <view class="period-calendar-legend-item"><view class="period-calendar-legend-dot period-calendar-legend-dot-start"></view>开始</view>
      <view class="period-calendar-legend-item"><view class="period-calendar-legend-dot period-calendar-legend-dot-in"></view>经期中</view>
      <view class="period-calendar-legend-item"><view class="period-calendar-legend-dot period-calendar-legend-dot-end"></view>结束</view>
    </view>
  </view>

  <!-- 选中日期的操作面板 -->
  <view wx:if="{{selectedDate}}" class="period-action-card">
    <view class="period-action-header">
      <view class="period-action-title-block">
        <view class="period-action-title">{{selectedDate}} <text class="period-action-week">{{selectedDateWeekCN}}</text></view>
        <view class="period-action-sub">
          <text wx:if="{{selectedDateInfo.hasRecord && selectedDateInfo.isEnd}}">已标记为结束日</text>
          <text wx:elif="{{selectedDateInfo.hasRecord && selectedDateInfo.isPeriod}}">已标记为经期（{{selectedDateInfo.segmentDay > 0 ? '第 ' + selectedDateInfo.segmentDay + ' 天' : ''}}）</text>
          <text wx:else>当天未标记</text>
        </view>
      </view>
    </view>

    <!-- 已标记的日期：显示取消按钮 -->
    <view class="period-action-buttons" wx:if="{{selectedDateInfo.hasRecord}}">
      <button class="period-action-btn period-action-btn-danger" size="mini" bindtap="onCancelMark">🗑 取消当天标记</button>
    </view>

    <!-- 未标记的日期：显示两个标记按钮 -->
    <view class="period-action-buttons" wx:if="{{!selectedDateInfo.hasRecord}}">
      <button class="period-action-btn period-action-btn-primary" size="mini" bindtap="onMarkPeriod">📌 标记为经期中</button>
      <button class="period-action-btn period-action-btn-end" size="mini" bindtap="onMarkEnd">🌙 标记为结束经期</button>
    </view>
  </view>

  <view class="period-bottom-spacer"></view>
</view>