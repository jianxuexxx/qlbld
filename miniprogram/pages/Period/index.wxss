/* ===== 经期页样式（项目基础色系：史迪奇蓝 + 紫色） ===== */
.container {
  padding: 24rpx 0 60rpx;
  background: var(--color-bg-page);
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 本次开始 / 上次结束（左右双卡） ===== */
.period-summary {
  display: flex;
  gap: 16rpx;
  margin: 20rpx 24rpx 0;
}
.period-summary-card {
  flex: 1;
  padding: 20rpx 20rpx 18rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}
.period-summary-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
}
/* 本次开始 - 主色蓝 */
.period-summary-card-start::before {
  background: linear-gradient(180deg, #2196F3 0%, #1565C0 100%);
}
/* 上次结束 - 紫色（项目强调色，与开始区分） */
.period-summary-card-end::before {
  background: linear-gradient(180deg, #7B68EE 0%, #5E50D8 100%);
}
.period-summary-label {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-bottom: 10rpx;
}
.period-summary-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.1;
  margin-bottom: 6rpx;
}
.period-summary-empty {
  color: var(--color-text-tertiary);
  font-weight: 400;
}
.period-summary-sub {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  line-height: 1.3;
}

/* ===== 日历 ===== */
.period-calendar {
  margin: 20rpx 24rpx 0;
  padding: 20rpx 16rpx 16rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-card);
}

/* 日历头部：左右箭头 + 中间年月选择（picker） */
.period-calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx 16rpx;
}
.period-calendar-nav {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--color-primary);
  font-weight: 700;
  border-radius: 50%;
  background: var(--color-primary-light);
  transition: transform 0.1s ease;
}
.period-calendar-nav:active {
  transform: scale(0.92);
  background: #BBDEFB;
}
.period-calendar-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  letter-spacing: 1rpx;
  flex: 1;
  min-width: 0;
}
/* 年月选择器：picker 默认 block 会占满父级，需设为 inline-block */
.period-calendar-title picker {
  display: inline-block;
}
/* 年月选择器：每段作为 picker 触发器 */
.period-calendar-title-pick {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: var(--color-primary-light);
  color: var(--color-primary-dark);
  font-weight: 700;
  font-size: 28rpx;
  line-height: 1.1;
  white-space: nowrap;
  letter-spacing: 1rpx;
  position: relative;
  padding-right: 40rpx;
}
.period-calendar-title-pick::after {
  content: '▾';
  font-size: 20rpx;
  color: var(--color-primary);
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  line-height: 1;
}
.period-calendar-title-sep {
  color: var(--color-text-tertiary);
  font-size: 24rpx;
  font-weight: 500;
}
.period-calendar-weekrow {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: 8rpx;
}
.period-calendar-weekcell {
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  padding: 8rpx 0;
  font-weight: 600;
}
.period-calendar-days {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 6rpx;
}
.period-calendar-day {
  position: relative;
  aspect-ratio: 1 / 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--color-text-primary);
  border-radius: 12rpx;
  background: var(--color-bg-page);
  transition: transform 0.1s ease, background-color 0.15s ease;
  overflow: hidden;
}
.period-calendar-day-empty {
  background: transparent;
  pointer-events: none;
}
.period-calendar-day:active {
  transform: scale(0.92);
}
.period-calendar-day-num {
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1;
}
.period-calendar-day-tag {
  position: absolute;
  bottom: 2rpx;
  font-size: 16rpx;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 0;
}

/* 今天：蓝色描边 */
.period-calendar-day-today {
  border: 2rpx solid var(--color-primary);
  box-sizing: border-box;
}

/* 经期中（中间）—— 浅蓝填充 + 蓝色文字（项目主色） */
.period-calendar-day-in {
  background: var(--color-primary-light);
  color: var(--color-primary-dark);
}
.period-calendar-day-in .period-calendar-day-num {
  color: var(--color-primary-dark);
  font-weight: 800;
}
.period-calendar-day-in .period-calendar-day-tag {
  color: var(--color-primary);
}

/* 经期开始 —— 主色蓝实底 + 白字 */
.period-calendar-day-start {
  background: linear-gradient(135deg, #2196F3 0%, #1565C0 100%);
  color: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(33, 150, 243, 0.4);
}
.period-calendar-day-start .period-calendar-day-num {
  color: #FFFFFF;
  font-weight: 800;
}
.period-calendar-day-start .period-calendar-day-tag {
  color: #FFFFFF;
}

/* 经期结束 —— 紫色实底 + 白字（项目强调色） */
.period-calendar-day-end {
  background: linear-gradient(135deg, #7B68EE 0%, #5E50D8 100%);
  color: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(123, 104, 238, 0.4);
}
.period-calendar-day-end .period-calendar-day-num {
  color: #FFFFFF;
  font-weight: 800;
}
.period-calendar-day-end .period-calendar-day-tag {
  color: #FFFFFF;
}

/* 同时是开始和结束（单天） */
.period-calendar-day-start.period-calendar-day-end {
  background: linear-gradient(135deg, #2196F3 0%, #5E50D8 100%);
}

/* 选中：保持原色 + 深蓝外圈 */
.period-calendar-day-selected {
  border: 3rpx solid #0D47A1;
  box-sizing: border-box;
  box-shadow: 0 2rpx 10rpx rgba(13, 71, 161, 0.4);
}

/* 图例 */
.period-calendar-legend {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 24rpx;
  padding: 12rpx 0 0;
  margin-top: 12rpx;
  border-top: 1rpx solid var(--color-divider);
}
.period-calendar-legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}
.period-calendar-legend-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}
.period-calendar-legend-dot-start {
  background: linear-gradient(135deg, #2196F3 0%, #1565C0 100%);
}
.period-calendar-legend-dot-in {
  background: var(--color-primary-light);
  border: 2rpx solid var(--color-primary);
  box-sizing: border-box;
}
.period-calendar-legend-dot-end {
  background: linear-gradient(135deg, #7B68EE 0%, #5E50D8 100%);
}

/* ===== 选中日期操作面板 ===== */
.period-action-card {
  margin: 20rpx 24rpx 0;
  padding: 24rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-card);
}
.period-action-header {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--color-divider);
}
.period-action-title-block { display: flex; flex-direction: column; gap: 4rpx; }
.period-action-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.period-action-week {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--color-primary);
  background: var(--color-primary-light);
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}
.period-action-sub {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
}
.period-action-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-top: 16rpx;
}
.period-action-btn {
  flex: 1;
  min-width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  margin: 0;
  padding: 0 24rpx;
  border: none;
}
.period-action-btn::after { border: none; }
/* 标记为经期中 - 主色蓝 */
.period-action-btn-primary {
  background: linear-gradient(135deg, #2196F3 0%, #1565C0 100%);
  color: #FFFFFF;
  box-shadow: var(--shadow-primary);
}
/* 标记为结束 - 紫色（与日历结束配色一致） */
.period-action-btn-end {
  background: linear-gradient(135deg, #7B68EE 0%, #5E50D8 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(123, 104, 238, 0.35);
}
/* 取消 - 浅灰底 */
.period-action-btn-danger {
  background: var(--color-bg-input);
  color: var(--color-text-secondary);
  box-shadow: none;
}

.period-bottom-spacer {
  height: 60rpx;
  flex-shrink: 0;
}