/* pages/MenuAdd/index.wxss */
.container {
  padding: 32rpx 32rpx 60rpx;
  background: var(--color-bg-page, #F0F4FA);
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 表单卡片 ===== */
.form-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 8rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(13, 42, 77, 0.06);
  margin-bottom: 32rpx;
}
.form-group {
  padding: 28rpx 0;
  border-bottom: 2rpx solid #F0F4FA;
}
.form-group:last-child {
  border-bottom: none;
}

.form-group_label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  font-weight: 600;
  color: #0D2A4D;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}
.form-group_label .required {
  color: #FF3B30;
  margin-left: 6rpx;
  font-weight: 400;
}

/* ===== 输入控件 ===== */
.form-control {
  width: 100%;
  font-size: 28rpx;
  color: #0D2A4D;
  background: #F5F6F8;
  padding: 22rpx 24rpx;
  border-radius: 14rpx;
  box-sizing: border-box;
  min-height: 48rpx;
  line-height: 1.4;
}
.form-control.placeholder {
  color: #C8C9CC;
}

.textarea {
  min-height: 200rpx;
  height: 200rpx;
  padding: 22rpx 24rpx;
  line-height: 1.6;
}

/* ===== 滑块 ===== */
.slider-container {
  background: #F5F6F8;
  padding: 28rpx 24rpx;
  border-radius: 14rpx;
}
.slider-value {
  text-align: center;
  margin-top: 14rpx;
  font-weight: 700;
  color: #1565C0;
  font-size: 32rpx;
  letter-spacing: 1rpx;
}

/* ===== 提交按钮 ===== */
.btn-submit {
  width: 100%;
  background: linear-gradient(135deg, #2196F3 0%, #1565C0 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 50rpx;
  padding: 28rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  margin-top: 8rpx;
  box-shadow: 0 8rpx 20rpx rgba(33, 150, 243, 0.35);
}
.btn-submit::after { border: none; }
.btn-submit:active {
  transform: scale(0.98);
  opacity: 0.95;
}

/* ===== 分类提示 ===== */
.cat-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8E8E93;
  line-height: 1.4;
}
