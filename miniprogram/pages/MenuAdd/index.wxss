.container {
  padding: 24rpx;
  background-color: #F0F4FA;
  min-height: 100vh;
  box-sizing: border-box;
}

.form-group {
  margin-bottom: 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(33,150,243,0.06);
  box-sizing: border-box;
  display: block;
  height: 100rpx;
  overflow: visible;
}

.form-group_label {
  font-weight: 600;
  font-size: 30rpx;
  margin-bottom: 20rpx;
  display: block;
  color: #0D2A4D;
  line-height: 1.4;
}

.form-control {
  width: 100% !important;
  height: 96rpx !important;
  min-height: 96rpx !important;
  line-height: 96rpx !important;
  padding: 0 28rpx !important;
  border: 2rpx solid #E4ECF6 !important;
  border-radius: 20rpx !important;
  box-sizing: border-box !important;
  background-color: #F0F4FA !important;
  font-size: 32rpx !important;
  color: #0D2A4D !important;
}

.form-control.input-single {
  height: 110rpx !important;
  min-height: 110rpx !important;
  line-height: 110rpx !important;
  padding: 0 28rpx !important;
  font-size: 32rpx !important;
}

.form-control:focus,
.form-control.focused {
  border-color: #2196F3;
  background-color: #FFFFFF;
}

.textarea {
  width: 100%;
  min-height: 240rpx;
  line-height: 1.6;
  padding: 24rpx 28rpx;
  border: 2rpx solid #E4ECF6;
  border-radius: 20rpx;
  box-sizing: border-box;
  background-color: #F0F4FA;
  font-size: 30rpx;
  color: #0D2A4D;
}

.slider-container {
  background-color: #F0F4FA;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
}

.slider-value {
  text-align: center;
  margin-top: 12rpx;
  font-weight: 700;
  font-size: 30rpx;
  color: #2196F3;
}

.btn-submit {
  width: 100%;
  background: linear-gradient(135deg, #2196F3 0%, #1565C0 100%);
  color: white;
  border: none;
  border-radius: 40rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 40rpx;
  box-shadow: 0 6rpx 20rpx rgba(33,150,243,0.25);
}

.btn-submit::after {
  border: none;
}

.btn-submit[disabled] {
  opacity: 0.6;
  color: #fff;
}