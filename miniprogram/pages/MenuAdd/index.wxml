<!-- pages/MenuAdd/index.wxml -->
<view class="page">
  <form bindsubmit="submitForm">

    <!-- 标题卡片 -->
    <view class="card card-header">
      <view class="card-header_title">新增菜品</view>
      <view class="card-header_sub">填写菜品信息后即可上架</view>
    </view>

    <!-- 基础信息 -->
    <view class="card">
      <view class="field">
        <view class="field-label">菜品名称</view>
        <input
          class="field-input"
          name="title"
          placeholder="请输入菜品名称"
          placeholder-class="field-placeholder"
          value="{{formData.title}}"
          bindinput="onInput"
          data-field="title"
        />
      </view>

      <view class="field-divider"></view>

      <view class="field">
        <view class="field-label">分类</view>
        <input
          class="field-input"
          name="category"
          placeholder="请输入分类名称"
          placeholder-class="field-placeholder"
          value="{{formData.category}}"
          bindinput="onInput"
          data-field="category"
        />
      </view>
    </view>

    <!-- 描述 -->
    <view class="card">
      <view class="field field--block">
        <view class="field-label">菜品描述</view>
        <textarea
          class="field-textarea"
          name="desc"
          placeholder="请输入菜品描述"
          placeholder-class="field-placeholder"
          value="{{formData.desc}}"
          bindinput="onInput"
          data-field="desc"
          auto-height
        />
      </view>
    </view>

    <button class="btn-submit" form-type="submit" hover-class="btn-submit--hover">添加菜品</button>

  </form>
</view>