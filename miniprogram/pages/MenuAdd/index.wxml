<!-- pages/MenuAdd/index.wxml -->
<view class="container">
  <form bindsubmit="submitForm">

    <view class="form-card">
      <view class="form-group">
        <view class="form-group_label">菜品名称<text class="required">*</text></view>
        <input class="form-control" name="title" placeholder="请输入菜品名称" value="{{formData.title}}" bindinput="onInput" data-field="title" />
      </view>

      <view class="form-group">
        <view class="form-group_label">分类<text class="required">*</text></view>
        <input class="form-control" name="category" placeholder="请输入分类名称" value="{{formData.category}}" bindinput="onInput" data-field="category" />
        <text class="cat-hint">输入新分类名后，菜单页将自动创建该分类</text>
      </view>

      <view class="form-group">
        <view class="form-group_label">菜品描述</view>
        <textarea class="form-control textarea" name="desc" placeholder="介绍一下这道菜吧～" value="{{formData.desc}}" bindinput="onInput" data-field="desc" auto-height="{{false}}" />
      </view>

      <view class="form-group">
        <view class="form-group_label">积分奖励</view>
        <view class="slider-container">
          <slider name="credit" min="1" max="{{maxCredit}}" value="{{formData.credit}}" show-value activeColor="#1565C0" backgroundColor="#E4ECF6" block-size="22" bindchange="onSliderChange" />
          <view class="slider-value">{{formData.credit}} 积分</view>
        </view>
      </view>
    </view>

    <button class="btn-submit" form-type="submit" hover-class="none">添加菜品</button>
  </form>
</view>
