<!-- pages/MenuAdd/index.wxml -->
<view class="container">
  <form bindsubmit="submitForm">
    <view class="form-group">
      <view class="form-group_label">菜品名称</view>
      <input class="form-control input-single" name="title" placeholder="请输入菜品名称" value="{{formData.title}}" bindinput="onInput" data-field="title" style="height:120rpx;min-height:120rpx;line-height:120rpx;font-size:32rpx;" />
    </view>

    <view class="form-group">
      <view class="form-group_label">分类</view>
      <input class="form-control input-single" name="category" placeholder="请输入分类名称" value="{{formData.category}}" bindinput="onInput" data-field="category" style="height:120rpx;min-height:120rpx;line-height:120rpx;font-size:32rpx;" />
    </view>

    <view class="form-group">
      <view class="form-group_label">菜品描述</view>
      <textarea class="textarea" name="desc" placeholder="请输入菜品描述" value="{{formData.desc}}" bindinput="onInput" data-field="desc" style="min-height:240rpx;font-size:30rpx;line-height:1.6;" />
    </view>

      <view class="form-group">
        <view class="form-group_label">积分奖励</view>
        <view class="slider-container">
          <slider name="credit" min="1" max="{{maxCredit}}" value="{{formData.credit}}" show-value activeColor="#1565C0" backgroundColor="#E4ECF6" block-size="22" bindchange="onSliderChange" />
          <view class="slider-value">{{formData.credit}} 积分</view>
        </view>
      </view>
    </view>

    <button class="btn-submit" form-type="submit" hover-class="none">添加菜品</button>
  </form>
</view>
