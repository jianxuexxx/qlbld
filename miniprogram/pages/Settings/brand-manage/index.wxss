/* ===== 品牌管理页 ===== */

.container {
  padding: 24rpx 24rpx 160rpx;
  background: var(--color-bg-page);
  min-height: 100vh;
}

/* 顶部 */
.hero {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 32rpx;
  border-radius: var(--radius-xl);
  background: linear-gradient(135deg, #2196F3 0%, #1565C0 100%);
  color: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(33, 150, 243, 0.3);
  margin-bottom: 16rpx;
}

.hero-emoji {
  font-size: 56rpx;
  line-height: 1;
  filter: drop-shadow(0 4rpx 8rpx rgba(0,0,0,0.18));
}

.hero-text {
  flex: 1;
  min-width: 0;
}

.hero-title {
  font-size: var(--font-lg);
  font-weight: 700;
  letter-spacing: 1rpx;
  margin-bottom: 4rpx;
}

.hero-sub {
  font-size: var(--font-xs);
  opacity: 0.9;
}

.hero-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 24rpx;
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  font-size: 28rpx;
  line-height: 1.2;
  flex-shrink: 0;
}
.hero-add:active { background: rgba(255, 255, 255, 0.32); }
.hero-add-plus {
  font-size: 36rpx;
  font-weight: 300;
  line-height: 1;
}
.hero-add-label {
  font-size: var(--font-xs);
  margin-top: 2rpx;
  line-height: 1;
}

/* 提示行 */
.tip {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
  padding: 8rpx 12rpx 20rpx;
  text-align: center;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 0 60rpx;
}
.empty-emoji {
  font-size: 120rpx;
  opacity: 0.4;
  margin-bottom: 16rpx;
}
.empty-title {
  font-size: var(--font-lg);
  color: var(--color-text-primary);
  font-weight: 600;
  margin-bottom: 8rpx;
}
.empty-sub {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
}

/* 列表 */
.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.brand-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  transition: transform 0.1s ease, background 0.1s ease;
}
.brand-card:active {
  transform: scale(0.99);
  background: var(--color-bg-input);
}

.brand-card.disabled {
  opacity: 0.55;
}

.brand-color {
  width: 16rpx;
  height: 80rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

.brand-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.brand-name {
  font-size: var(--font-base);
  font-weight: 700;
  color: var(--color-text-primary);
}

.brand-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

.brand-count {
  font-weight: 500;
}

.brand-status {
  padding: 2rpx 10rpx;
  border-radius: var(--radius-sm);
  background: #FFEBEE;
  color: #FA5151;
  font-weight: 600;
}
.brand-status.enabled {
  background: #E8F5E9;
  color: #2E7D32;
}

.brand-products {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-top: 2rpx;
}

.brand-arrow {
  font-size: 40rpx;
  color: var(--color-text-tertiary);
  font-weight: 300;
  flex-shrink: 0;
  line-height: 1;
}

.bottom-spacer {
  height: 80rpx;
}