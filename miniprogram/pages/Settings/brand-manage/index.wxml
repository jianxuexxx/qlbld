<view class="container">
  <!-- 顶部信息 -->
  <view class="hero">
    <view class="hero-emoji">🧋</view>
    <view class="hero-text">
      <view class="hero-title">奶茶品牌</view>
      <view class="hero-sub">已启用 {{enabledCount}} 个 · 已停用 {{disabledCount}} 个</view>
    </view>
    <view class="hero-add" bindtap="onAdd">
      <text class="hero-add-plus">＋</text>
      <text class="hero-add-label">新增</text>
    </view>
  </view>

  <!-- 提示 -->
  <view class="tip">点击任一品牌卡片可编辑或启停</view>

  <!-- 空状态 -->
  <view wx:if="{{brands.length === 0}}" class="empty">
    <view class="empty-emoji">🧋</view>
    <view class="empty-title">还没有任何品牌</view>
    <view class="empty-sub">点击右上角"新增"添加第一个品牌</view>
  </view>

  <!-- 品牌列表 -->
  <view wx:if="{{brands.length > 0}}" class="list">
    <view
      wx:for="{{brands}}"
      wx:key="_id"
      class="brand-card {{item.enabled === false ? 'disabled' : ''}}"
      data-id="{{item._id}}"
      bindtap="onEdit"
    >
      <view class="brand-color" style="background:{{item.color}}"></view>
      <view class="brand-info">
        <view class="brand-name">{{item.name}}</view>
        <view class="brand-meta">
          <text wx:if="{{item.enabled === false}}" class="brand-status">已停用</text>
          <text wx:else class="brand-status enabled">使用中</text>
          <text class="brand-count">{{item.products.length}} 款奶茶</text>
        </view>
        <view wx:if="{{item.products.length > 0}}" class="brand-products">
          {{item.products.slice(0, 4).join('、')}}<text wx:if="{{item.products.length > 4}}">…</text>
        </view>
      </view>
      <text class="brand-arrow">›</text>
    </view>
  </view>

  <view class="bottom-spacer"></view>
</view>