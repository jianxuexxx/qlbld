/* pages/Settings/menu-edit/index.wxss */
.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 200rpx;
  box-sizing: border-box;
}

.form-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(13, 42, 77, 0.05);
}
.form-row {
  padding: 28rpx 28rpx;
  border-bottom: 2rpx solid #F0F4FA;
}
.form-row:last-child {
  border-bottom: none;
}
.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #0D2A4D;
  margin-bottom: 14rpx;
}
.form-required {
  color: #FF3B30;
  margin-left: 4rpx;
}
.form-input {
  width: 100%;
  font-size: 28rpx;
  color: #0D2A4D;
  background: #F5F6F8;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
}
.form-textarea {
  width: 100%;
  font-size: 26rpx;
  color: #0D2A4D;
  background: #F5F6F8;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  min-height: 140rpx;
  box-sizing: border-box;
}

.status-toggle {
  display: flex;
  background: #F5F6F8;
  border-radius: 16rpx;
  padding: 6rpx;
}
.status-opt {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #8E8E93;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}
.status-opt.active {
  background: #FFFFFF;
  color: #1565C0;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(13, 42, 77, 0.08);
}

/* 操作栏 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -2rpx 12rpx rgba(13, 42, 77, 0.06);
  z-index: 10;
}
.btn-secondary,
.btn-primary {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}
.btn-secondary {
  background: #F5F6F8;
  color: #0D2A4D;
}
.btn-secondary-hover {
  background: #E4ECF6;
}
.btn-primary {
  background: linear-gradient(135deg, #2196F3 0%, #1565C0 100%);
  color: #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(33, 150, 243, 0.35);
}
.btn-primary-hover {
  transform: scale(0.98);
  opacity: 0.95;
}
