/* ===== 品牌编辑页 ===== */

.container {
  padding: 24rpx 24rpx 200rpx;
}

.form-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: 8rpx 32rpx;
  box-shadow: var(--shadow-card);
}

.form-row {
  padding: 28rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.form-row--block {
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
}

.form-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.form-label {
  font-size: var(--font-base);
  color: var(--color-text-primary);
  font-weight: 600;
}

.form-hint {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
  line-height: 1.5;
}

.form-divider {
  height: 1rpx;
  background: var(--color-divider);
}

/* 输入框 */
.form-input {
  width: 100%;
  height: 80rpx;
  font-size: var(--font-base);
  color: var(--color-text-primary);
  background: var(--color-bg-input);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  box-sizing: border-box;
  line-height: 80rpx;
}

/* 颜色选择 */
.color-grid {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 16rpx;
  margin-top: 8rpx;
}

.color-cell {
  aspect-ratio: 1 / 1;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid transparent;
  transition: transform 0.15s ease, border-color 0.15s ease;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.color-cell:active {
  transform: scale(0.92);
}

.color-cell.active {
  border-color: var(--color-text-primary);
  transform: scale(1.08);
}

.color-check {
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3);
}

/* 自定义颜色输入 */
.custom-color-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 4rpx;
}

.color-preview {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 1rpx solid var(--color-divider);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
  transition: background 0.15s ease;
}

.custom-color-input {
  flex: 1;
  height: 72rpx;
  font-size: var(--font-base);
  color: var(--color-text-primary);
  background: var(--color-bg-input);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  box-sizing: border-box;
  line-height: 72rpx;
  font-family: monospace;
  letter-spacing: 1rpx;
}

/* 底部按钮 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(20rpx);
  display: flex;
  gap: 24rpx;
  border-top: 1rpx solid var(--color-divider);
  z-index: 10;
}

.btn-secondary {
  flex: 0 0 auto;
  height: 88rpx;
  padding: 0 48rpx;
  border-radius: var(--radius-pill);
  background: var(--color-bg-input);
  color: var(--color-text-secondary);
  font-size: var(--font-base);
  font-weight: 600;
  border: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.btn-secondary-hover { background: #DCE6F2; }

.btn-primary {
  flex: 1;
  height: 88rpx;
  border-radius: var(--radius-pill);
  background: linear-gradient(135deg, #2196F3 0%, #1565C0 100%);
  color: #FFFFFF;
  font-size: var(--font-base);
  font-weight: 600;
  border: none;
  box-shadow: var(--shadow-primary);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.btn-primary-hover { transform: translateY(2rpx); box-shadow: 0 2rpx 8rpx rgba(33,150,243,0.25); }