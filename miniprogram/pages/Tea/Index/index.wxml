<view class="container">
  <!-- 顶部信息卡 -->
  <view class="hero">
    <view class="hero-left">
      <view class="hero-emoji">🧋</view>
      <view class="hero-text">
        <view class="hero-title">{{currentUser}}的奶茶记录</view>
        <view class="hero-sub">今天 {{todayCount}} 杯 · 累计 {{totalCount}} 杯</view>
      </view>
    </view>
  </view>

  <!-- 主 Tab 切换：列表 / 统计 -->
  <view class="main-tabs">
    <view class="main-tab {{mainTab === 'list' ? 'active' : ''}}" bindtap="switchMainTab" data-tab="list">📋 列表</view>
    <view class="main-tab {{mainTab === 'stats' ? 'active' : ''}}" bindtap="switchMainTab" data-tab="stats">📊 统计</view>
  </view>

  <!-- ===== 列表 Tab ===== -->
  <view wx:if="{{mainTab === 'list'}}">
    <!-- 空状态 -->
    <view wx:if="{{allRecords.length === 0}}" class="empty">
      <view class="empty-emoji">🧋</view>
      <view class="empty-title">还没有记录</view>
      <view class="empty-sub">点击右下角按钮记录第一杯</view>
    </view>

    <view wx:if="{{allRecords.length > 0}}">
      <!-- 今日 -->
      <view wx:if="{{todayRecords.length > 0}}" class="list-section">
        <view class="section-header">
          <view class="section-title">📅 今日</view>
          <view class="section-count">{{todayRecords.length}} 杯</view>
        </view>
        <view class="list">
          <view
            wx:for="{{todayRecords}}"
            wx:key="_id"
            class="record-card-wrap"
          >
            <view class="record-card" data-id="{{item._id}}" bindtap="onTapItem">
              <view class="record-brand" style="background:{{brandColors[item.brand] || '#8E8E93'}}">
                <text class="record-brand-text">{{item.brand}}</text>
              </view>
              <view class="record-info">
                <view class="record-title">{{item.product}}</view>
                <view class="record-meta">
                  <text class="record-dot">{{item.ratingEmoji}}</text>
                  <text class="record-rating-label-inline" style="color:{{ratingMap[item.rating].color}};">{{ratingMap[item.rating].label}}</text>
                  <text wx:if="{{item.note}}" class="record-note-inline">{{item.note}}</text>
                </view>
              </view>
              <view class="record-rating" style="color:{{ratingMap[item.rating].color}}; background:{{ratingMap[item.rating].color}}1A;">
                <text class="record-rating-emoji">{{ratingMap[item.rating].emoji}}</text>
                <text class="record-rating-label">{{ratingMap[item.rating].label}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 全部（倒序） -->
      <view class="list-section">
        <view class="section-header">
          <view class="section-title">🗂️ 全部记录</view>
          <view class="section-count">{{allRecords.length}} 杯</view>
        </view>
        <view class="list">
          <view
            wx:for="{{allRecords}}"
            wx:key="_id"
            class="record-card-wrap"
          >
            <view class="record-card" data-id="{{item._id}}" bindtap="onTapItem">
              <view class="record-brand" style="background:{{brandColors[item.brand] || '#8E8E93'}}">
                <text class="record-brand-text">{{item.brand}}</text>
              </view>
              <view class="record-info">
                <view class="record-title">{{item.product}}</view>
                <view class="record-meta">
                  <text class="record-date-iso">{{item.date}}</text>
                  <text class="record-date-friendly">{{item.friendlyDate}}</text>
                </view>
                <view wx:if="{{item.note}}" class="record-note">{{item.note}}</view>
              </view>
              <view class="record-rating" style="color:{{ratingMap[item.rating].color}}; background:{{ratingMap[item.rating].color}}1A;">
                <text class="record-rating-emoji">{{ratingMap[item.rating].emoji}}</text>
                <text class="record-rating-label">{{ratingMap[item.rating].label}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 统计 Tab（内嵌 Stats 页内容） ===== -->
  <view wx:if="{{mainTab === 'stats'}}" class="stats-tab">
    <!-- 顶部信息卡 -->
    <view class="stats-hero">
      <view class="stats-hero-emoji">📊</view>
      <view class="stats-hero-text">
        <view class="stats-hero-title">共 {{statsTotalCount}} 杯</view>
        <view class="stats-hero-sub">{{statsPeriodLabel}}记录</view>
      </view>
    </view>

    <!-- 时间范围（上下排：左右切换） -->
    <view class="inline-switch-row">
      <text class="inline-switch-label">时间</text>
      <text class="inline-switch-divider">·</text>
      <text class="inline-switch-opt {{statsPeriod === 'month' ? 'active' : ''}}" bindtap="onStatsPeriodTap" data-p="month">当月</text>
      <text class="inline-switch-divider">·</text>
      <text class="inline-switch-opt {{statsPeriod === 'year' ? 'active' : ''}}" bindtap="onStatsPeriodTap" data-p="year">当年</text>
    </view>

    <!-- 图表类型（上下排：左右切换） -->
    <view class="inline-switch-row">
      <text class="inline-switch-label">图表</text>
      <text class="inline-switch-divider">·</text>
      <text class="inline-switch-opt {{statsChart === 'pie' ? 'active' : ''}}" bindtap="onStatsChartTap" data-c="pie">饼状图</text>
      <text class="inline-switch-divider">·</text>
      <text class="inline-switch-opt {{statsChart === 'bar' ? 'active' : ''}}" bindtap="onStatsChartTap" data-c="bar">柱状图</text>
    </view>

    <!-- 图表区 -->
    <view class="chart-card">
      <canvas
        canvas-id="{{canvasId}}"
        id="{{canvasId}}"
        class="chart-canvas"
        style="width:{{canvasW}}px; height:{{canvasH}}px;"
      ></canvas>
    </view>

    <!-- 排行榜 -->
    <view wx:if="{{statsRanking.length > 0}}" class="ranking-card">
      <view class="ranking-title">🥇 排行</view>
      <view
        wx:for="{{statsRanking}}"
        wx:key="key"
        class="ranking-row"
      >
        <view class="ranking-rank">{{index + 1}}</view>
        <view class="ranking-color" style="background:{{item.color}}"></view>
        <view class="ranking-label">{{item.label}}</view>
        <view class="ranking-count">{{item.count}} 杯</view>
        <view class="ranking-percent">{{item.percent}}%</view>
      </view>
    </view>

    <view wx:if="{{statsTotalCount === 0}}" class="empty">
      <view class="empty-emoji">📭</view>
      <view class="empty-title">{{statsPeriodLabel}}还没有记录</view>
      <view class="empty-sub">快去记录你的第一杯奶茶吧～</view>
    </view>
  </view>

  <view class="bottom-spacer"></view>

  <!-- 浮动添加按钮 -->
  <view class="fab" bindtap="onAdd">
    <text class="fab-plus">＋</text>
    <text class="fab-label">记录</text>
  </view>
</view>