/* ===== Tea/Index 主页样式 ===== */

.container {
  padding: 24rpx 24rpx 200rpx;
  background: var(--color-bg-page);
  min-height: 100vh;
}

/* ===== 顶部信息卡 ===== */
.hero {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-radius: var(--radius-xl);
  background: linear-gradient(135deg, #2196F3 0%, #1565C0 100%);
  color: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(33, 150, 243, 0.3);
  margin-bottom: 24rpx;
}

.hero-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
  min-width: 0;
}

.hero-emoji {
  font-size: 56rpx;
  line-height: 1;
  filter: drop-shadow(0 4rpx 8rpx rgba(0,0,0,0.18));
}

.hero-text {
  flex: 1;
  min-width: 0;
}

.hero-title {
  font-size: var(--font-lg);
  font-weight: 700;
  letter-spacing: 1rpx;
  margin-bottom: 4rpx;
}

.hero-sub {
  font-size: var(--font-xs);
  opacity: 0.9;
}

/* ===== 主 Tab 切换 ===== */
.main-tabs {
  display: flex;
  background: var(--color-bg-card);
  border-radius: var(--radius-pill);
  padding: 8rpx;
  margin: 0 0 24rpx;
  box-shadow: var(--shadow-card);
}

.main-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: var(--font-base);
  color: var(--color-text-secondary);
  border-radius: var(--radius-pill);
  font-weight: 600;
  transition: all 0.2s ease;
}

.main-tab.active {
  background: linear-gradient(135deg, #2196F3 0%, #1565C0 100%);
  color: #FFFFFF;
  box-shadow: var(--shadow-primary);
}

/* ===== 列表分段 ===== */
.list-section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 12rpx;
}

.section-title {
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--color-text-primary);
}

.section-count {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
  background: var(--color-bg-card);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
}

/* ===== 空状态 ===== */
.empty {
  text-align: center;
  padding: 100rpx 0 60rpx;
  color: var(--color-text-secondary);
}

.empty-emoji {
  font-size: 120rpx;
  opacity: 0.4;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: var(--font-lg);
  color: var(--color-text-primary);
  font-weight: 600;
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
}

/* ===== 列表 ===== */
.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-card-wrap {
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--color-bg-card);
  box-shadow: var(--shadow-card);
}

.record-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: var(--color-bg-card);
  transition: background 0.1s ease;
}

.record-card:active {
  background: var(--color-bg-input);
}

.record-brand {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #FFFFFF;
  font-weight: 700;
  font-size: 22rpx;
  letter-spacing: 0.5rpx;
  text-align: center;
  line-height: 1.1;
  padding: 4rpx;
  box-sizing: border-box;
}

.record-brand-text {
  display: block;
  word-break: break-all;
}

.record-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.record-title {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
  flex-wrap: wrap;
}

.record-dot { font-size: 18rpx; }
.record-date-iso { font-family: monospace; }
.record-date-friendly { color: var(--color-text-secondary); }
.record-rating-label-inline { font-weight: 600; }
.record-note-inline {
  background: var(--color-bg-input);
  padding: 2rpx 10rpx;
  border-radius: var(--radius-sm);
  max-width: 280rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-note {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  background: var(--color-bg-input);
  padding: 6rpx 12rpx;
  border-radius: var(--radius-sm);
  margin-top: 4rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.record-rating {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-md);
  flex-shrink: 0;
  font-weight: 600;
}

.record-rating-emoji {
  font-size: 28rpx;
  line-height: 1;
}

.record-rating-label {
  font-size: 20rpx;
  margin-top: 4rpx;
  line-height: 1;
}

/* ===== 左滑按钮配色（图标模式：保留白色圆形背景 + 彩色图标） ===== */
/* 编辑按钮：背景浅蓝色 */
.editBtn .weui-slideview__btn {
  background-color: #E3F2FD !important;
}
/* 删除按钮：背景浅红色 */
.removeBtn .weui-slideview__btn {
  background-color: #FFEBEE !important;
}

/* ===== 底部留白 ===== */
.bottom-spacer {
  height: 160rpx;
}

/* ===== 浮动按钮 ===== */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 80rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: linear-gradient(135deg, #2196F3 0%, #1565C0 100%);
  color: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(33, 150, 243, 0.45);
  z-index: 100;
  border: none;
}

.fab:active {
  transform: scale(0.92);
  box-shadow: 0 2rpx 8rpx rgba(33, 150, 243, 0.3);
}

.fab-plus {
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
}

.fab-label {
  font-size: 22rpx;
  margin-top: 4rpx;
  line-height: 1;
  font-weight: 500;
}

/* ====== 统计 Tab 内嵌 ======= */
.stats-tab {
  /* 让统计部分和列表部分视觉一致 */
}

.stats-hero {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 32rpx;
  border-radius: var(--radius-xl);
  background: linear-gradient(135deg, #7B68EE 0%, #5E50D8 100%);
  color: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(123, 104, 238, 0.3);
  margin-bottom: 24rpx;
}

.stats-hero-emoji {
  font-size: 56rpx;
  line-height: 1;
}
.stats-hero-text { flex: 1; min-width: 0; }
.stats-hero-title {
  font-size: var(--font-lg);
  font-weight: 700;
  letter-spacing: 1rpx;
  margin-bottom: 4rpx;
}
.stats-hero-sub {
  font-size: var(--font-xs);
  opacity: 0.9;
}

/* 内嵌文字切换器：紧凑、和谐 */
.inline-switch-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0 0 16rpx;
  padding: 20rpx 24rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  font-size: var(--font-base);
}
.inline-switch-label {
  color: var(--color-text-tertiary);
  font-size: var(--font-sm);
  flex-shrink: 0;
}
.inline-switch-divider {
  color: var(--color-divider);
  font-size: var(--font-sm);
}
.inline-switch-opt {
  color: var(--color-text-secondary);
  font-weight: 600;
  font-size: var(--font-base);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  transition: all 0.15s ease;
}
.inline-switch-opt.active {
  color: #FFFFFF;
  background: linear-gradient(135deg, #2196F3 0%, #1565C0 100%);
  box-shadow: 0 2rpx 8rpx rgba(33, 150, 243, 0.25);
}

/* 图表卡 */
.chart-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
  display: flex;
  justify-content: center;
  align-items: center;
}
.chart-canvas {
  display: block;
}

/* 排行榜 */
.ranking-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: 24rpx 24rpx 16rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}
.ranking-title {
  font-size: var(--font-base);
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 16rpx;
}
.ranking-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}
.ranking-row:last-child { border-bottom: none; }
.ranking-rank {
  width: 36rpx;
  height: 36rpx;
  border-radius: var(--radius-round);
  background: var(--color-bg-input);
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ranking-row:nth-child(1) .ranking-rank {
  background: linear-gradient(135deg, #FFC107 0%, #FFA000 100%);
  color: #FFFFFF;
}
.ranking-row:nth-child(2) .ranking-rank {
  background: linear-gradient(135deg, #B0BEC5 0%, #78909C 100%);
  color: #FFFFFF;
}
.ranking-row:nth-child(3) .ranking-rank {
  background: linear-gradient(135deg, #D4915E 0%, #A0662F 100%);
  color: #FFFFFF;
}
.ranking-color {
  width: 16rpx;
  height: 16rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}
.ranking-label {
  flex: 1;
  font-size: var(--font-base);
  color: var(--color-text-primary);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ranking-count {
  font-size: var(--font-base);
  color: var(--color-text-primary);
  font-weight: 700;
}
.ranking-percent {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
  min-width: 60rpx;
  text-align: right;
}