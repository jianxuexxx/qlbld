<wxs module="util" src="../util.wxs" />

<!-- 史迪奇主题欢迎横幅 -->
<view class="stitch-banner">
  <view class="stitch-banner-stars">
    <text class="stitch-star stitch-star-1">✦</text>
    <text class="stitch-star stitch-star-2">✦</text>
    <text class="stitch-star stitch-star-3">✦</text>
    <text class="stitch-star stitch-star-4">✧</text>
  </view>
  <view class="stitch-banner-emoji">👽</view>
  <view class="stitch-banner-title">Aloha ~ 史迪奇便利店</view>
  <view class="stitch-banner-sub">小蓝怪和他的家人们，准备好一起冒险啦 🚀</view>
  <view class="stitch-banner-tag">OHANA · 家人即一切</view>
</view>

<!-- 顶部 Tab 切换（可左右滑动） -->
<view class="home-tabs">
  <view class="home-tabs-bar">
    <view class="home-tabs-item {{activeTab === 0 ? 'active' : ''}}" bindtap="switchTab" data-index="0">
      <text class="home-tabs-text">🏠 首页信息</text>
      <view wx:if="{{activeTab === 0}}" class="home-tabs-underline"></view>
    </view>
    <view class="home-tabs-item {{activeTab === 1 ? 'active' : ''}}" bindtap="switchTab" data-index="1">
      <text class="home-tabs-text">📋 任务列表</text>
      <view wx:if="{{pendingMissionCount > 0}}" class="home-tabs-badge">{{pendingMissionCount}}</view>
      <view wx:if="{{activeTab === 1}}" class="home-tabs-underline"></view>
    </view>
  </view>
</view>

<swiper class="home-swiper"
  current="{{activeTab}}"
  bindchange="onSwiperChange"
  duration="300"
  circular="{{false}}">

  <!-- ===== Tab 0: 首页信息 ===== -->
  <swiper-item>
    <scroll-view class="home-scroll" scroll-y="true">
      <view style="width:100%; background: none;">

        <view class="form-group_label">👋 你好，{{currentUser}}</view>
        <view class="form-group" style="box-shadow: 0 4px 8px 0 rgba(33,150,243,0.06), 0 6px 20px 0 rgba(33,150,243,0.08);">
          <view class="form-cell">
            <view class="slide">
              <view class="title">{{userA}}的积分：{{creditA}}</view>
            </view>
          </view>
          <view class="form-cell">
            <view class="slide">
              <view class="title">{{userB}}的积分：{{creditB}}</view>
            </view>
          </view>
          <view class="form-cell">
            <view class="slide slide--mission" bindtap="goToMissionTab">
              <view class="title">📋 {{currentUser}}待办任务</view>
              <view class="slide-mission-badge">{{pendingMissionCount || 0}}</view>
            </view>
          </view>
        </view>

        <view class="subscribe-card">
            <view class="subscribe-card-title" wx:if="{{subscribed}}">✅ 已开启服务通知</view>
            <view class="subscribe-card-title" wx:else>🔔 接收对方的服务通知</view>
            <view class="subscribe-card-sub" wx:if="{{subscribed}}">对方发布任务 / 你点单 / 任务完成时，你都会收到微信服务通知</view>
            <view class="subscribe-card-sub" wx:else>建议开启，否则对方完成你的任务时你收不到提醒</view>
            <button class="subscribe-btn" hover-class="subscribe-btn-hover" bindtap="onTapSubscribe">
              <text wx:if="{{subscribed}}">🔄 重新订阅</text>
              <text wx:else>🔔 立即订阅</text>
            </button>
        </view>
      </view>
    </scroll-view>
  </swiper-item>

  <!-- ===== Tab 1: 任务列表（原 Mission 页功能） ===== -->
  <swiper-item>
    <scroll-view class="home-scroll" scroll-y="true">

      <!-- 空状态 -->
      <view wx:if="{{allMissions.length === 0}}" class="empty-hero">
        <view class="empty-hero-emoji">📋</view>
        <view class="empty-hero-title">暂无任务</view>
        <view class="empty-hero-sub">发布一个任务，开始攒积分之旅～</view>
      </view>

      <view wx:if="{{allMissions.length > 0}}">
        <view class="form-group mission-search-wrap">
          <view class="search-bar">
            <icon class="search-icon" type="search" size="20" color="#8E8E93"></icon>
            <input class="search-input" placeholder="搜索任务" bindinput="onSearch" value="{{search}}" />
          </view>
        </view>

        <view class="form-group_label">未完成 <text class="mission-count">{{unfinishedMissions.length}}</text></view>
        <view class="form-group" wx:if="{{unfinishedMissions.length > 0}}"
        style="z-index: 0; box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.05), 0 6px 20px 0 rgba(0, 0, 0, 0.05);">
          <view class="form-cell" wx:for="{{unfinishedMissions}}" wx:key="index">
            <block wx:if="{{item._openid === currentOpenid}}">
              <view class="slide" data-index="{{index}}" bindtap="toDetailPageUpper">
                <view class="mission-info">
                  <view class="mission-info_title">{{util.filterStr(item.title, 10)}}</view>
                  <view class="mission-info_award">💰 {{util.filterStr(item.credit, 10)}} 积分</view>
                  <view class="mission-info_date">📅 {{util.cutStr(item.date, 10)}} 创建</view>
                  <view class="mission-info_waiting">⏳ 等待对方完成</view>
                </view>
                <view class="mission-info_author">
                  <image wx:if="{{item._openid === _openidA}}" mode="aspectFill" src="../Mission/Images/MissionA.png"/>
                  <image class="author-img" wx:elif="{{item._openid === _openidB}}" mode="aspectFill" src="../Mission/Images/MissionB.png"/>
                  <image wx:else mode="aspectFill" src="../Mission/Images/MissionA.png"/>
                </view>
                <image wx:if="{{item.star}}" class="star" src="../Mission/Images/Star.png" />
              </view>
            </block>
            <block wx:else>
              <mp-slideview buttons="{{slideButtons}}" data-index='{{index}}' icon="{{true}}" bindbuttontap="slideButtonTapUpper">
                <view class="slide" data-index="{{index}}" bindtap="toDetailPageUpper">
                  <view class="mission-info">
                    <view class="mission-info_title">{{util.filterStr(item.title, 10)}}</view>
                    <view class="mission-info_award">💰 {{util.filterStr(item.credit, 10)}} 积分</view>
                    <view class="mission-info_date">📅 {{util.cutStr(item.date, 10)}} 创建</view>
                  </view>
                  <view class="mission-info_author">
                    <image wx:if="{{item._openid === _openidA}}" mode="aspectFill" src="../Mission/Images/MissionA.png"/>
                    <image wx:elif="{{item._openid === _openidB}}" mode="aspectFill" src="../Mission/Images/MissionB.png"/>
                    <image wx:else mode="aspectFill" src="../Mission/Images/MissionB.png"/>
                  </view>
                  <image wx:if="{{item.star}}" class="star" src="../Mission/Images/Star.png" />
                </view>
              </mp-slideview>
            </block>
          </view>
        </view>

        <view class="form-group_label">已完成 <text class="mission-count">{{finishedMissions.length}}</text></view>
        <view class="form-group" wx:if="{{finishedMissions.length > 0}}"
        style="z-index: 0; box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.05), 0 6px 20px 0 rgba(0, 0, 0, 0.05);">
          <view class="form-cell" wx:for="{{finishedMissions}}" wx:key="index">
            <mp-slideview buttons="{{slideButtons}}" data-index='{{index}}' icon="{{true}}" bindbuttontap="slideButtonTapLower">
              <view class="slide" data-index="{{index}}" bindtap="toDetailPageLower">
                <view class="mission-info">
                  <view class="mission-info_title">{{util.filterStr(item.title, 10)}}</view>
                  <view class="mission-info_award">💰 {{util.filterStr(item.credit, 10)}} 积分</view>
                  <view class="mission-info_date">📅 {{util.cutStr(item.date, 10)}} 创建</view>
                </view>
                <view class="mission-info_author">
                    <image class="author-img" wx:if="{{item._openid === _openidA}}" mode="aspectFill" src="../Mission/Images/MissionA.png"/>
                    <image class="author-img" wx:elif="{{item._openid === _openidB}}" mode="aspectFill" src="../Mission/Images/MissionB.png"/>
                    <image class="author-img" wx:else mode="aspectFill" src="../Mission/Images/MissionB.png"/>
                </view>
                <image wx:if="{{item.star}}" class="star" src="../Mission/Images/Star.png" />
              </view>
            </mp-slideview>
          </view>
        </view>
      </view>

      <view class="mission-bottom-spacer"></view>
    </scroll-view>
  </swiper-item>
</swiper>

<!-- 浮动「+」按钮：发布任务 -->
<view class="mission-fab" bindtap="toAddPage" wx:if="{{activeTab === 1}}">
  <text class="mission-fab-plus">＋</text>
  <text class="mission-fab-label">任务</text>
</view>