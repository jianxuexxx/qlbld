/* ===== MainPage 首页（统一规范） ===== */

.form-cell { padding: 0; }

.slide {
  display: flex;
  align-items: center;
  padding: 24rpx;
  position: relative;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  margin: 0 24rpx 16rpx;
  box-sizing: border-box;
  transition: transform 0.1s ease, box-shadow 0.2s ease;
}
.slide:active {
  transform: scale(0.99);
  box-shadow: var(--shadow-card-hover);
}

.slide--mission {
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
  cursor: pointer;
}

.title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.3;
  flex: 1;
}

.swiper-image {
  display: block;
  height: 100%;
  width: 100%;
  position: relative;
  background-color: var(--color-bg-sub);
  background-repeat: no-repeat;
  background-size: cover;
  background-position: center;
  border-radius: 0;
}

/* 欢迎横幅 */
.welcome-banner {
  margin: 24rpx 24rpx 16rpx;
  padding: 32rpx 32rpx;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  border-radius: var(--radius-xl);
  color: #fff;
  box-shadow: var(--shadow-primary);
  position: relative;
  overflow: hidden;
}
.welcome-banner-title {
  font-size: var(--font-xl);
  font-weight: 700;
  letter-spacing: 1rpx;
  margin-bottom: 8rpx;
}
.welcome-banner-sub {
  font-size: var(--font-sm);
  opacity: 0.9;
  line-height: 1.4;
}

/* ===== 史迪奇主题横幅 ===== */
.stitch-banner {
  position: relative;
  margin: 24rpx 24rpx 16rpx;
  padding: 40rpx 32rpx 36rpx;
  background: linear-gradient(135deg, #2196F3 0%, #1565C0 60%, #0D47A1 100%);
  border-radius: var(--radius-xl);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(33,150,243,0.35);
  overflow: hidden;
}
.stitch-banner::before {
  content: '';
  position: absolute;
  top: -60rpx;
  left: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(123,104,238,0.5) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}
.stitch-banner::after {
  content: '';
  position: absolute;
  bottom: -50rpx;
  right: -30rpx;
  width: 180rpx;
  height: 180rpx;
  background: radial-gradient(circle, rgba(255,193,7,0.35) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}
.stitch-banner-stars {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}
.stitch-star {
  position: absolute;
  color: #FFC107;
  font-size: 28rpx;
  opacity: 0.85;
  animation: stitch-twinkle 2.4s ease-in-out infinite;
  text-shadow: 0 0 8rpx rgba(255,193,7,0.6);
}
.stitch-star-1 { top: 32rpx; right: 60rpx; animation-delay: 0s; }
.stitch-star-2 { top: 90rpx; right: 28rpx; font-size: 22rpx; animation-delay: 0.6s; }
.stitch-star-3 { bottom: 24rpx; right: 80rpx; font-size: 20rpx; animation-delay: 1.2s; }
.stitch-star-4 { top: 28rpx; right: 130rpx; font-size: 18rpx; animation-delay: 1.8s; }

@keyframes stitch-twinkle {
  0%, 100% { opacity: 0.3; transform: scale(0.9); }
  50% { opacity: 1; transform: scale(1.2); }
}

.stitch-banner-emoji {
  font-size: 80rpx;
  line-height: 1;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 1;
  filter: drop-shadow(0 4rpx 8rpx rgba(0,0,0,0.2));
}
.stitch-banner-title {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
  position: relative;
  z-index: 1;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}
.stitch-banner-sub {
  font-size: 26rpx;
  opacity: 0.95;
  line-height: 1.5;
  position: relative;
  z-index: 1;
  margin-bottom: 16rpx;
}
.stitch-banner-tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  background: rgba(255,255,255,0.18);
  border: 2rpx solid rgba(255,255,255,0.3);
  border-radius: 999rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  font-weight: 600;
  position: relative;
  z-index: 1;
  backdrop-filter: blur(8rpx);
}

/* 待办徽标 */
.slide-mission-badge {
  flex-shrink: 0;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #FF3B30 0%, #E53935 100%);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 36rpx;
  text-align: center;
  margin-left: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(229, 57, 53, 0.35);
}

/* ===== 顶部 Tab 切换栏 ===== */
.home-tabs {
  position: sticky;
  top: 0;
  z-index: 50;
  background-color: #FFFFFF;
  border-bottom: 2rpx solid #EEF2F8;
}
.home-tabs-bar {
  display: flex;
  align-items: stretch;
  height: 96rpx;
  padding: 0 16rpx;
}
.home-tabs-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  color: #5A6B85;
  font-size: 28rpx;
  font-weight: 500;
  transition: color 0.2s ease;
}
.home-tabs-item.active {
  color: #1565C0;
  font-weight: 700;
}
.home-tabs-text {
  position: relative;
  z-index: 1;
}
.home-tabs-underline {
  position: absolute;
  left: 50%;
  bottom: 12rpx;
  width: 56rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: linear-gradient(90deg, #2196F3, #1565C0);
  transform: translateX(-50%);
}
.home-tabs-badge {
  position: absolute;
  top: 16rpx;
  right: 18%;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #FF3B30;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 32rpx;
  text-align: center;
  box-sizing: border-box;
}

/* ===== Swiper 高度 ===== */
.home-swiper {
  height: calc(100vh - 96rpx - env(safe-area-inset-top) - 100rpx);
  width: 100%;
}
.home-scroll {
  height: 100%;
  width: 100%;
  box-sizing: border-box;
}

/* ===== 任务引导头 ===== */
.mission-hero {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 24rpx 24rpx 8rpx;
  padding: 28rpx 28rpx;
  background: linear-gradient(135deg, #2196F3 0%, #1565C0 100%);
  border-radius: var(--radius-xl);
  color: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(33, 150, 243, 0.25);
}
.mission-hero-icon {
  font-size: 64rpx;
  line-height: 1;
  flex-shrink: 0;
  filter: drop-shadow(0 4rpx 8rpx rgba(0,0,0,0.18));
}
.mission-hero-text {
  flex: 1;
  min-width: 0;
}
.mission-hero-title {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  margin-bottom: 4rpx;
  text-shadow: 0 2rpx 6rpx rgba(0,0,0,0.12);
}
.mission-hero-sub {
  font-size: 22rpx;
  opacity: 0.92;
  line-height: 1.4;
}
.mission-hero-stats {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 16rpx;
  background: rgba(255,255,255,0.18);
  border-radius: 16rpx;
  border: 2rpx solid rgba(255,255,255,0.25);
  backdrop-filter: blur(6rpx);
}
.mission-hero-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 56rpx;
}
.mission-hero-stat-num {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.1;
}
.mission-hero-stat-label {
  font-size: 20rpx;
  opacity: 0.85;
  margin-top: 2rpx;
}
.mission-hero-divider {
  width: 1rpx;
  height: 36rpx;
  background-color: rgba(255,255,255,0.35);
}

/* ===== 任务搜索 ===== */
.mission-search-wrap {
  margin: 16rpx 24rpx !important;
  padding: 0 24rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 38rpx;
  box-shadow: 0 4rpx 14rpx rgba(13, 42, 77, 0.06);
  box-sizing: border-box;
}
.mission-search-wrap .search-bar {
  flex: 1;
  display: flex;
  align-items: center;
}
.mission-search-wrap .search-icon {
  margin-right: 10rpx;
}
.mission-search-wrap .search-input {
  flex: 1;
  font-size: 26rpx;
  color: #0D2A4D;
  height: 76rpx;
}

/* 任务分组计数 */
.mission-count {
  display: inline-block;
  min-width: 32rpx;
  height: 28rpx;
  padding: 0 10rpx;
  margin-left: 8rpx;
  border-radius: 14rpx;
  background: rgba(33, 150, 243, 0.12);
  color: #1565C0;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 28rpx;
  text-align: center;
  vertical-align: middle;
}

/* ===== 任务卡片信息 ===== */
.mission-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.mission-info_title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0D2A4D;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.mission-info_award {
  font-size: 24rpx;
  color: #1565C0;
  font-weight: 600;
}
.mission-info_date {
  font-size: 22rpx;
  color: #8E8E93;
}
.mission-info_waiting {
  font-size: 22rpx;
  color: #FF6F00;
  font-weight: 600;
}
.mission-info_author {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  margin-left: 16rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #F2F5FB;
}
.mission-info_author image {
  width: 100%;
  height: 100%;
}
.star {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 32rpx;
  height: 32rpx;
  z-index: 2;
}

/* 空状态 */
.empty-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 32rpx 80rpx;
  text-align: center;
}
.empty-hero-emoji {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.85;
}
.empty-hero-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 12rpx;
}
.empty-hero-sub {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  line-height: 1.5;
}

/* 底部留白 */
.mission-bottom-spacer {
  height: 200rpx;
  flex-shrink: 0;
}

/* ===== FAB：浮动新增任务按钮 ===== */
.mission-fab {
  position: fixed;
  right: 28rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2196F3 0%, #1565C0 100%);
  color: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(33, 150, 243, 0.4);
  z-index: 100;
  transition: transform 0.1s ease, box-shadow 0.2s ease;
}
.mission-fab:active {
  transform: scale(0.94);
  box-shadow: 0 6rpx 14rpx rgba(33, 150, 243, 0.3);
}
.mission-fab-plus {
  font-size: 44rpx;
  line-height: 1;
  font-weight: 300;
}
.mission-fab-label {
  font-size: 20rpx;
  margin-top: 2rpx;
  letter-spacing: 1rpx;
  opacity: 0.92;
}

/* 订阅卡片 */
.subscribe-card {
  margin: 24rpx 24rpx 60rpx;
  padding: 28rpx 28rpx 32rpx;
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(33, 150, 243, 0.12);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  border: 2rpx solid rgba(33, 150, 243, 0.15);
}
.subscribe-card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0D2A4D;
  letter-spacing: 1rpx;
}
.subscribe-card-sub {
  font-size: 24rpx;
  color: #1F3A5F;
  line-height: 1.5;
  opacity: 0.85;
}

/* ===== 待办任务提示行（缩为单行） ===== */
.mission-hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 24rpx 8rpx;
  padding: 22rpx 28rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  border-left: 8rpx solid #2196F3;
  transition: transform 0.1s ease;
}
.mission-hint:active {
  transform: scale(0.99);
  background: var(--color-bg-input);
}
.mission-hint-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}
.mission-hint-icon { font-size: 32rpx; line-height: 1; }
.mission-hint-text {
  font-size: var(--font-base);
  color: var(--color-text-primary);
  font-weight: 600;
}
.mission-hint-arrow {
  font-size: 36rpx;
  color: var(--color-text-tertiary);
  font-weight: 300;
}

/* ===== 工具宫格（3 列） ===== */
.tools-section {
  margin: 24rpx 24rpx 0;
}
.tools-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 16rpx;
  padding-left: 4rpx;
}
.tools-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: 20rpx 16rpx;
  box-shadow: var(--shadow-card);
}
.tool-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 16rpx 0;
  border-radius: var(--radius-md);
  transition: transform 0.1s ease, background 0.1s ease;
}
.tool-cell:active {
  transform: scale(0.96);
  background: var(--color-bg-input);
}
.tool-cell-disabled {
  opacity: 0.55;
  pointer-events: none;
}
.tool-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  line-height: 1;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}
.tool-icon-tea {
  background: linear-gradient(135deg, #FFB4A2 0%, #E5989B 100%);
  color: #FFFFFF;
}
.tool-icon-grey {
  background: var(--color-bg-input);
  box-shadow: none;
  color: var(--color-text-tertiary);
}
.tool-label {
  font-size: var(--font-xs);
  color: var(--color-text-primary);
  font-weight: 500;
  letter-spacing: 0.5rpx;
}
.tool-cell-disabled .tool-label {
  color: var(--color-text-tertiary);
}

/* 订阅按钮 */
.subscribe-btn {
  margin-top: 8rpx;
  padding: 18rpx 0;
  text-align: center;
  background: linear-gradient(135deg, #2196F3 0%, #1565C0 100%);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(33, 150, 243, 0.35);
  letter-spacing: 2rpx;
  border: none;
}
.subscribe-btn::after { border: none; }
.subscribe-btn:active {
  transform: scale(0.98);
  opacity: 0.92;
}
.subscribe-btn-hover {
  transform: scale(0.98);
  opacity: 0.92;
}