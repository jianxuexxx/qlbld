/* ===== MainPage 首页（统一规范） ===== */

.form-cell { padding: 0; }

.slide {
  display: flex;
  align-items: center;
  padding: 24rpx;
  position: relative;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  margin: 0 24rpx 16rpx;
  box-sizing: border-box;
  transition: transform 0.1s ease, box-shadow 0.2s ease;
}
.slide:active {
  transform: scale(0.99);
  box-shadow: var(--shadow-card-hover);
}

.title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.3;
}

.swiper-image {
  display: block;
  height: 100%;
  width: 100%;
  position: relative;
  background-color: var(--color-bg-sub);
  background-repeat: no-repeat;
  background-size: cover;
  background-position: center;
  border-radius: 0;
}

/* 欢迎横幅 */
.welcome-banner {
  margin: 24rpx 24rpx 16rpx;
  padding: 32rpx 32rpx;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  border-radius: var(--radius-xl);
  color: #fff;
  box-shadow: var(--shadow-primary);
  position: relative;
  overflow: hidden;
}
.welcome-banner-title {
  font-size: var(--font-xl);
  font-weight: 700;
  letter-spacing: 1rpx;
  margin-bottom: 8rpx;
}
.welcome-banner-sub {
  font-size: var(--font-sm);
  opacity: 0.9;
  line-height: 1.4;
}

/* ===== 史迪奇主题横幅 ===== */
.stitch-banner {
  position: relative;
  margin: 24rpx 24rpx 16rpx;
  padding: 40rpx 32rpx 36rpx;
  background: linear-gradient(135deg, #2196F3 0%, #1565C0 60%, #0D47A1 100%);
  border-radius: var(--radius-xl);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(33,150,243,0.35);
  overflow: hidden;
}
/* 紫色光晕（左上） */
.stitch-banner::before {
  content: '';
  position: absolute;
  top: -60rpx;
  left: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(123,104,238,0.5) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}
/* 黄色光晕（右下） */
.stitch-banner::after {
  content: '';
  position: absolute;
  bottom: -50rpx;
  right: -30rpx;
  width: 180rpx;
  height: 180rpx;
  background: radial-gradient(circle, rgba(255,193,7,0.35) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}
.stitch-banner-stars {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}
.stitch-star {
  position: absolute;
  color: #FFC107;
  font-size: 28rpx;
  opacity: 0.85;
  animation: stitch-twinkle 2.4s ease-in-out infinite;
  text-shadow: 0 0 8rpx rgba(255,193,7,0.6);
}
.stitch-star-1 { top: 32rpx; right: 60rpx; animation-delay: 0s; }
.stitch-star-2 { top: 90rpx; right: 28rpx; font-size: 22rpx; animation-delay: 0.6s; }
.stitch-star-3 { bottom: 24rpx; right: 80rpx; font-size: 20rpx; animation-delay: 1.2s; }
.stitch-star-4 { top: 28rpx; right: 130rpx; font-size: 18rpx; animation-delay: 1.8s; }

@keyframes stitch-twinkle {
  0%, 100% { opacity: 0.3; transform: scale(0.9); }
  50% { opacity: 1; transform: scale(1.2); }
}

.stitch-banner-emoji {
  font-size: 80rpx;
  line-height: 1;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 1;
  filter: drop-shadow(0 4rpx 8rpx rgba(0,0,0,0.2));
}
.stitch-banner-title {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
  position: relative;
  z-index: 1;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}
.stitch-banner-sub {
  font-size: 26rpx;
  opacity: 0.95;
  line-height: 1.5;
  position: relative;
  z-index: 1;
  margin-bottom: 16rpx;
}
.stitch-banner-tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  background: rgba(255,255,255,0.18);
  border: 2rpx solid rgba(255,255,255,0.3);
  border-radius: 999rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  font-weight: 600;
  position: relative;
  z-index: 1;
  backdrop-filter: blur(8rpx);
}

/* 订阅卡片 */
.subscribe-card {
  margin: 24rpx 24rpx 60rpx;
  padding: 28rpx 28rpx 32rpx;
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(33, 150, 243, 0.12);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  border: 2rpx solid rgba(33, 150, 243, 0.15);
}
.subscribe-card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0D2A4D;
  letter-spacing: 1rpx;
}
.subscribe-card-sub {
  font-size: 24rpx;
  color: #1F3A5F;
  line-height: 1.5;
  opacity: 0.85;
}

/* 订阅按钮 */
.subscribe-btn {
  margin-top: 8rpx;
  padding: 18rpx 0;
  text-align: center;
  background: linear-gradient(135deg, #2196F3 0%, #1565C0 100%);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(33, 150, 243, 0.35);
  letter-spacing: 2rpx;
  border: none;
}
.subscribe-btn::after { border: none; }
.subscribe-btn:active {
  transform: scale(0.98);
  opacity: 0.92;
}
.subscribe-btn-hover {
  transform: scale(0.98);
  opacity: 0.92;
}
