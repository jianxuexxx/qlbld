/* ===== Market 商品列表页（统一规范） ===== */

.background {
  width: 280rpx;
  margin-top: 5vh;
  opacity: 0.7;
}

.title {
  margin-top: 24rpx;
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--color-text-primary);
  letter-spacing: 1rpx;
}
.subtitle {
  margin-top: 8rpx;
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

.swiper-image {
  display: block;
  height: 100%;
  width: 100%;
  background-color: var(--color-bg-sub);
  background-position: center;
  background-repeat: no-repeat;
  background-size: cover;
}

.form-cell { padding: 0; }

/* 商品卡片 */
.slide {
  display: flex;
  align-items: center;
  padding: 24rpx;
  position: relative;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  margin: 0 24rpx 16rpx;
  box-sizing: border-box;
  transition: transform 0.1s ease, box-shadow 0.2s ease;
}
.slide:active {
  transform: scale(0.99);
  box-shadow: var(--shadow-card-hover);
}

.item-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.item-info_title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item-info_desc {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}
.item-info_date {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}
.item-info_author {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: var(--radius-round);
  overflow: hidden;
  background: var(--color-bg-input);
}
.item-info_author image {
  width: 100%;
  height: 100%;
}
.item-info_award {
  display: inline-flex;
  align-items: center;
  height: 32rpx;
  padding: 0 12rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-xs);
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-weight: 600;
  margin-top: 4rpx;
  line-height: 1;
}

.mission-info_waiting {
  display: inline-flex;
  align-items: center;
  height: 32rpx;
  padding: 0 12rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-xs);
  background: var(--color-bg-input);
  color: var(--color-text-tertiary);
  font-weight: 600;
  margin-top: 4rpx;
  line-height: 1;
}

.star {
  width: 32rpx;
  height: 32rpx;
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  z-index: 2;
}

.buyBtn   .weui-slideview__btn { background-color: greenyellow; }
.starBtn  .weui-slideview__btn { background-color: gold; }
.removeBtn .weui-slideview__btn { background-color: lightsalmon; }

.btn-normal {
  margin: 4rpx;
  color: white;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  border: none;
  border-radius: var(--radius-pill);
  font-size: var(--font-sm);
  padding: 12rpx 24rpx;
}
.btn-hover {
  color: var(--color-text-primary);
  background: var(--color-bg-input);
}

.search-bar {
  position: relative;
  width: 100%;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  background: var(--color-bg-input);
  border-radius: 36rpx;
  height: 72rpx;
  padding: 0 24rpx;
}
.search-input {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  font-size: var(--font-base);
  color: var(--color-text-primary);
  background: transparent;
}
.search-input::placeholder { color: var(--color-text-placeholder); }
.search-icon {
  margin-right: 12rpx;
  color: var(--color-text-tertiary);
  font-size: var(--font-base);
}

/* 顶部标题条（升级自黑底白字） */
.page-title {
  position: relative;
  font-size: var(--font-base);
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
  color: var(--color-text-primary);
  background: transparent;
  font-weight: 600;
  z-index: 10;
  box-sizing: border-box;
}
