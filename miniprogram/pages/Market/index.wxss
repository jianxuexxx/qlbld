/* ===== Market 商品列表页（统一规范） ===== */

/* 空状态 */
.empty-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 32rpx 80rpx;
  text-align: center;
}
.empty-hero-emoji {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.85;
}
.empty-hero-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 12rpx;
}
.empty-hero-sub {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  line-height: 1.5;
}

/* 商城引导头（替代轮播图） */
.market-hero {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 24rpx 24rpx 16rpx;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #2196F3 0%, #1565C0 100%);
  border-radius: var(--radius-xl);
  color: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(33, 150, 243, 0.22);
}
.market-hero-icon {
  font-size: 56rpx;
  line-height: 1;
  flex-shrink: 0;
  filter: drop-shadow(0 4rpx 8rpx rgba(0,0,0,0.18));
}
.market-hero-text {
  flex: 1;
  min-width: 0;
}
.market-hero-title {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  margin-bottom: 4rpx;
  text-shadow: 0 2rpx 6rpx rgba(0,0,0,0.12);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.market-hero-sub {
  font-size: 22rpx;
  opacity: 0.92;
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,0.1);
}

/* 柔和分隔线 */
.divider-soft {
  height: 2rpx;
  margin: 8rpx 24rpx 0;
  background: linear-gradient(90deg, transparent 0%, var(--color-divider) 50%, transparent 100%);
}

/* 兼容：旧轮播图样式 */
.swiper-image {
  display: block;
  height: 100%;
  width: 100%;
  background-color: var(--color-bg-sub);
  background-position: center;
  background-repeat: no-repeat;
  background-size: cover;
}
.background {
  width: 280rpx;
  margin-top: 5vh;
  opacity: 0.7;
}
.title {
  margin-top: 24rpx;
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--color-text-primary);
  letter-spacing: 1rpx;
}
.subtitle {
  margin-top: 8rpx;
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

.form-cell { padding: 0; }

/* 商品卡片 */
.slide {
  display: flex;
  align-items: center;
  padding: 24rpx;
  position: relative;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  margin: 0 24rpx 16rpx;
  box-sizing: border-box;
  transition: transform 0.1s ease, box-shadow 0.2s ease;
}
.slide:active {
  transform: scale(0.99);
  box-shadow: var(--shadow-card-hover);
}

.item-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.item-info_title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item-info_desc {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}
.item-info_date {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}
.item-info_author {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: var(--radius-round);
  overflow: hidden;
  background: var(--color-bg-input);
}
.item-info_author image {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}
.item-info_award {
  display: inline-flex;
  align-items: center;
  height: 32rpx;
  padding: 0 12rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-xs);
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-weight: 600;
  margin-top: 4rpx;
  line-height: 1;
}

.mission-info_waiting {
  display: inline-flex;
  align-items: center;
  height: 32rpx;
  padding: 0 12rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-xs);
  background: var(--color-bg-input);
  color: var(--color-text-tertiary);
  font-weight: 600;
  margin-top: 4rpx;
  line-height: 1;
}

.star {
  width: 32rpx;
  height: 32rpx;
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  z-index: 2;
}

.buyBtn   .weui-slideview__btn { background-color: greenyellow; }
.starBtn  .weui-slideview__btn { background-color: gold; }
.removeBtn .weui-slideview__btn { background-color: lightsalmon; }

.btn-normal {
  margin: 4rpx;
  color: white;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  border: none;
  border-radius: var(--radius-pill);
  font-size: var(--font-sm);
  padding: 12rpx 24rpx;
}
.btn-hover {
  color: var(--color-text-primary);
  background: var(--color-bg-input);
}

.search-bar {
  position: relative;
  width: 100%;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  background: var(--color-bg-input);
  border-radius: 36rpx;
  height: 72rpx;
  padding: 0 24rpx;
}
.search-input {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  font-size: var(--font-base);
  color: var(--color-text-primary);
  background: transparent;
}
.search-input::placeholder { color: var(--color-text-placeholder); }
.search-icon {
  margin-right: 12rpx;
  color: var(--color-text-tertiary);
  font-size: var(--font-base);
}

/* 顶部标题条（升级自黑底白字） */
.page-title {
  position: relative;
  font-size: var(--font-base);
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
  color: var(--color-text-primary);
  background: transparent;
  font-weight: 600;
  z-index: 10;
  box-sizing: border-box;
}
